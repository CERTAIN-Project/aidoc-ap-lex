# CQ: What oversight model does the AI system require, including human-in-the-loop, human-on-the-loop, or human-in-command?
# Question: lexreq:altai-r1-05-cq2
# Requirement: lexreq:altai-r1-05
# Terms: aidoc:HumanOversightMechanism, aidoc:hasHumanOversight

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?mechanism ?type ?label WHERE {
  ?system aidoc:hasHumanOversight ?mechanism .
  ?mechanism a ?type ;
             rdfs:label ?label .
}
