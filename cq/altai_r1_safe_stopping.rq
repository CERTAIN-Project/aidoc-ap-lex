# CQ: How does the AI system support safe stopping, aborting, or overriding of its operation when needed?
# Question: lexreq:altai-r1-07-cq1
# Requirement: lexreq:altai-r1-07
# Terms: aidoc-lex:StopMechanism, aidoc-lex:OverrideMechanism, aidoc:hasHumanOversight

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?mechanism ?type ?label WHERE {
  ?system aidoc:hasHumanOversight ?mechanism .
  ?mechanism a ?type ;
             rdfs:label ?label .
  VALUES ?type { aidoc-lex:StopMechanism aidoc-lex:OverrideMechanism }
}
