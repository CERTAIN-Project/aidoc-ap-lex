# CQ: What attack scenarios and entry points does the AI system evaluate, including data poisoning, model evasion, and model inversion?
# Question: lexreq:altai-r2-02-cq2
# Requirement: lexreq:altai-r2-02
# Terms: aidoc:hasRisk, vair:SecurityMeasure, aidoc-lex:addressesRisk

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX vair: <https://w3id.org/vair#>
SELECT ?risk ?attack ?measure WHERE {
  ?measure a vair:SecurityMeasure ;
           aidoc-lex:addressesRisk ?risk , ?attack .
  ?system aidoc:hasRisk ?risk .
  FILTER(?attack != ?risk)
}
