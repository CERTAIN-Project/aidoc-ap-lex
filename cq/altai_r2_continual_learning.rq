# CQ: How does the AI system monitor and constrain continual-learning behaviour after deployment?
# Question: lexreq:altai-r2-13-cq3
# Requirement: lexreq:altai-r2-13
# Terms: aidoc-lex:PredeterminedChange, aidoc:PostMarketPerformanceEvaluationActivity, aidoc-lex:FeedbackLoopRisk

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
SELECT ?change ?review ?risk ?measure WHERE {
  ?change a aidoc-lex:PredeterminedChange .
  ?review a aidoc:PostMarketPerformanceEvaluationActivity .
  ?risk aidoc-lex:riskCategory aidoc-lex:FeedbackLoopRisk .
  OPTIONAL { ?measure aidoc-lex:addressesRisk ?risk }
}
