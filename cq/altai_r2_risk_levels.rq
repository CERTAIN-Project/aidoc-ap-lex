# CQ: How does the AI system define risks, risk metrics, and risk levels for each use case?
# Question: lexreq:altai-r2-04-cq1
# Requirement: lexreq:altai-r2-04
# Terms: aidoc:hasRisk, aidoc-lex:riskCategory, aidoc-lex:riskAcceptanceCriteria

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
SELECT ?system ?risk ?category ?criteria WHERE {
  ?system aidoc:hasRisk ?risk .
  ?risk aidoc-lex:riskCategory ?category .
  OPTIONAL { ?system aidoc-lex:hasManagementSystem ?rms . ?rms aidoc-lex:riskAcceptanceCriteria ?criteria }
}
ORDER BY ?risk
