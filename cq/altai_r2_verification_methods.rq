# CQ: How does the AI system use verification and validation methods to demonstrate reliability and reproducibility?
# Question: lexreq:altai-r2-11-cq1
# Requirement: lexreq:altai-r2-11
# Terms: aidoc:ModelEvaluation, aidoc:evaluationMethod, aidoc-lex:ComplianceTest

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?activity ?method WHERE {
  {
    ?activity a aidoc:ModelEvaluation ; aidoc:evaluationMethod ?method .
  } UNION {
    ?activity a aidoc-lex:ComplianceTest ; rdfs:label ?method .
  }
}
