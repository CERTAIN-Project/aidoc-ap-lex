# CQ: What mechanisms does the AI system use to communicate the purpose, criteria, benefits, limitations, and risks of its decisions?
# Question: lexreq:altai-r4-03-cq2
# Requirement: lexreq:altai-r4-03
# Terms: aidoc:hasIntendedPurpose, aidoc:hasCapability, dpv-aiact:InstructionForUse

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?purpose ?limitation ?ifu WHERE {
  ?system aidoc:hasIntendedPurpose ?purpose ;
          aidoc:hasCapability ?capability ;
          aidoc-lex:hasInstructionsForUse ?ifu .
  ?capability rdfs:comment ?limitation .
}
