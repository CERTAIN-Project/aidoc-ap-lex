# CQ: What mechanisms identify, document, and explain conflicts or trade-offs between requirements and ethical principles?
# Question: lexreq:altai-r7-06-cq2
# Requirement: lexreq:altai-r7-06
# Terms: aidoc-lex:TradeOffAssessment, aidoc-lex:justification

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?assessment ?justification ?decidedBy WHERE {
  ?assessment a aidoc-lex:TradeOffAssessment ;
              aidoc-lex:justification ?justification .
  OPTIONAL { ?assessment prov:wasAssociatedWith ?decidedBy }
}
