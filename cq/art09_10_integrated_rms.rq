# CQ: How are the aspects provided in paragraphs 1 to 9 incorporated into those risk management processes?
# Question: lexreq:aiact-art9-10-cq2
# Requirement: lexreq:aiact-art9-10
# Terms: aidoc-lex:integratedWith, dpv-aiact:RiskManagementSystem, aidoc:AIProvider

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX dpv-aiact: <https://w3id.org/dpv/legal/eu/aiact#>
SELECT ?system ?provider ?rms ?other WHERE {
  ?system aidoc:isProvidedBy ?provider ;
          aidoc-lex:hasManagementSystem ?rms .
  ?rms a dpv-aiact:RiskManagementSystem ;
       aidoc-lex:integratedWith ?other .
}
