# CQ: What known risks are being identified?
# Question: lexreq:aiact-art9-2-a-cq1
# Requirement: lexreq:aiact-art9-2-a
# Terms: aidoc-lex:RiskAssessment, aidoc-lex:assesses, aidoc-lex:identifiesRisk, aidoc-lex:riskCategory

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?assessment ?risk ?category WHERE {
  ?assessment a aidoc-lex:RiskAssessment ;
              aidoc-lex:assesses ?system ;
              aidoc-lex:identifiesRisk ?risk .
  ?system a aidoc:AISystem .
  OPTIONAL { ?risk aidoc-lex:riskCategory ?category }
}
ORDER BY ?risk ?category
