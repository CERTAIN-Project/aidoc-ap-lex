# CQ: What additional risks are being identified from the post-market monitoring?
# Question: lexreq:aiact-art9-2-c-cq1
# Requirement: lexreq:aiact-art9-2-c
# Terms: aidoc:PostMarketMonitoringActivity, aidoc:logsActivity, aidoc-lex:RiskAssessment, aidoc:hasRisk

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?monitoring ?logging ?assessment ?risk WHERE {
  ?monitoring a aidoc:PostMarketMonitoringActivity .
  ?assessment a aidoc-lex:RiskAssessment ;
              prov:wasInformedBy ?monitoring ;
              aidoc-lex:identifiesRisk ?risk .
  OPTIONAL { ?logging aidoc:logsActivity ?monitoring }
}
