# CQ: What measures are adopted?
# Question: lexreq:aiact-art9-2-d-cq1
# Requirement: lexreq:aiact-art9-2-d
# Terms: aidoc-lex:RiskControlMeasure, vair:SecurityMeasure, aidoc-lex:addressesRisk, aidoc-lex:controlFunction

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX vair: <https://w3id.org/vair#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?risk ?measure ?type ?function WHERE {
  ?system aidoc:hasRisk ?risk .
  ?measure aidoc-lex:addressesRisk ?risk ;
           a ?type .
  { ?type rdfs:subClassOf* aidoc-lex:RiskControlMeasure } UNION { VALUES ?type { vair:SecurityMeasure } }
  OPTIONAL { ?measure aidoc-lex:controlFunction ?function }
}
ORDER BY ?risk ?measure
