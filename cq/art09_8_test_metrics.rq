# CQ: What prior defined metrics and probabilistic thresholds are used for testing the high-risk AI system?
# Question: lexreq:aiact-art9-8-cq4
# Requirement: lexreq:aiact-art9-8
# Terms: aidoc-lex:ComplianceTest, aidoc-lex:declaresMetric, aidoc:ModelEvaluation, aidoc:hasPerformanceMetric, aidoc:evaluationMethod

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
SELECT ?test ?metric ?evaluation ?method WHERE {
  ?test a aidoc-lex:ComplianceTest ;
        aidoc-lex:assesses ?system .
  ?system aidoc-lex:hasInstructionsForUse ?ifu .
  ?ifu aidoc-lex:declaresMetric ?metric .
  ?evaluation a aidoc:ModelEvaluation ;
              aidoc:hasPerformanceMetric ?metric ;
              aidoc:evaluationMethod ?method .
}
