# CQ: How are those design choices documented?
# Question: lexreq:aiact-art10-2-a-cq2
# Requirement: lexreq:aiact-art10-2-a
# Terms: aidoc-lex:DataGovernanceFramework, aidoc-lex:DesignChoice, aidoc-lex:includesDocument, aidoc-lex:justification

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?framework ?choice ?justification WHERE {
  ?framework a aidoc-lex:DataGovernanceFramework ;
             aidoc-lex:includesDocument ?choice .
  ?choice a aidoc-lex:DesignChoice .
  OPTIONAL { ?choice aidoc-lex:justification ?justification }
}
