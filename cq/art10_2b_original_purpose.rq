# CQ: What is the original purpose of the data collection, where personal data are involved?
# Question: lexreq:aiact-art10-2-b-cq3
# Requirement: lexreq:aiact-art10-2-b
# Terms: aidoc-lex:containsSpecialCategoryData, aidoc-lex:originalPurposeOfCollection

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?dataset ?purpose ?specialCategories WHERE {
  ?dataset a aidoc:Dataset ;
           aidoc-lex:originalPurposeOfCollection ?purpose .
  OPTIONAL { ?dataset aidoc-lex:containsSpecialCategoryData ?specialCategories }
}
