# CQ: What assumptions are formulated for the datasets?
# Question: lexreq:aiact-art10-2-d-cq1
# Requirement: lexreq:aiact-art10-2-d
# Terms: aidoc-lex:dataAssumption

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?dataset ?assumption WHERE {
  ?dataset a aidoc:Dataset ;
           aidoc-lex:dataAssumption ?assumption .
}
