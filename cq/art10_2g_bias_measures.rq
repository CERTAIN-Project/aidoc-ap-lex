# CQ: What measures are used to detect possible biases?
# Question: lexreq:aiact-art10-2-g-cq1
# Requirement: lexreq:aiact-art10-2-g
# Terms: aidoc-lex:BiasMitigationMeasure, aidoc-lex:addressesRisk, aidoc-lex:controlFunction

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?measure ?function ?risk WHERE {
  ?measure a aidoc-lex:BiasMitigationMeasure ;
           aidoc-lex:controlFunction ?function .
  OPTIONAL { ?measure aidoc-lex:addressesRisk ?risk }
}
ORDER BY ?function ?measure
