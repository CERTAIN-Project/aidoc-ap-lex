# CQ: How do the datasets reflect the functional setting in which the high-risk AI system is intended to be used?
# Question: lexreq:aiact-art10-4-cq3
# Requirement: lexreq:aiact-art10-4
# Terms: aidoc:Dataset, aidoc:dataScope, aidoc:hasIntendedPurpose

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
SELECT ?system ?purpose ?dataset ?scope WHERE {
  ?system aidoc:hasIntendedPurpose ?purpose .
  ?dataset a aidoc:Dataset ;
           aidoc:dataScope ?scope .
}
