# CQ: How is access restricted to authorised persons with appropriate confidentiality obligations?
# Question: lexreq:aiact-art10-5-c-cq3
# Requirement: lexreq:aiact-art10-5-c
# Terms: vair:SecurityMeasure, aidoc-lex:accountableAgent

PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX vair: <https://w3id.org/vair#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?measure ?label ?agent WHERE {
  ?measure a vair:SecurityMeasure ;
           rdfs:label ?label ;
           aidoc-lex:accountableAgent ?agent .
}
