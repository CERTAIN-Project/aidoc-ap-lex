# CQ: Do the records of processing activities include the reasons as to why the processing of special categories of personal data is strictly necessary to detect and correct biases?
# Question: lexreq:aiact-art10-5-f-cq2
# Requirement: lexreq:aiact-art10-5-f
# Terms: aidoc-lex:ProcessingRecord, aidoc-lex:justification, aidoc-lex:retentionPeriod

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?record ?justification ?retention WHERE {
  ?record a aidoc-lex:ProcessingRecord ;
          aidoc-lex:justification ?justification .
  OPTIONAL { ?record aidoc-lex:retentionPeriod ?retention }
}
