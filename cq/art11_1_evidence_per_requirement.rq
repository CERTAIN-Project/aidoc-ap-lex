# CQ: How does the technical documentation demonstrate that the high-risk AI system complies with the requirements set out in this Section?
# Question: lexreq:aiact-art11-1-cq4
# Requirement: lexreq:aiact-art11-1
# Terms: aidoc-lex:addressesRequirement

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?requirement ?label (COUNT(DISTINCT ?evidence) AS ?evidenceItems) WHERE {
  ?requirement a lexreq:Requirement ;
               lexreq:framework lexreq:AIAct ;
               rdfs:label ?label .
  ?evidence aidoc-lex:addressesRequirement ?requirement .
}
GROUP BY ?requirement ?label
ORDER BY ?requirement
