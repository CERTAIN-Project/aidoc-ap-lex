# CQ: What events relevant to the traceability of the functioning of the high-risk AI system are recorded?
# Question: lexreq:aiact-art12-2-cq1
# Requirement: lexreq:aiact-art12-2
# Terms: aidoc-lex:LogEntry, aidoc-lex:concernsSystem, aidoc-lex:loggedEventType, aidoc-lex:partOfLog

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?entry ?eventType ?time WHERE {
  ?entry a aidoc-lex:LogEntry ;
         aidoc-lex:concernsSystem ?system ;
         aidoc-lex:partOfLog ?log ;
         aidoc-lex:loggedEventType ?eventType .
  OPTIONAL { ?entry prov:generatedAtTime ?time }
}
ORDER BY ?time
