# CQ: Are the contact details of the provider included in the instructions?
# Question: lexreq:aiact-art13-3-a-cq2
# Requirement: lexreq:aiact-art13-3-a
# Terms: aidoc-lex:AuthorisedRepresentative, aidoc-lex:contactDetails

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?agent ?role ?contact WHERE {
  { ?system aidoc:isProvidedBy ?agent . BIND("provider" AS ?role) }
  UNION
  { ?system a aidoc:AISystem . ?agent a aidoc-lex:AuthorisedRepresentative . BIND("authorised representative" AS ?role) }
  ?agent aidoc-lex:contactDetails ?contact .
}
