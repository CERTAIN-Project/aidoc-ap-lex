# CQ: What is the performance of the high-risk AI system regarding specific persons or groups of persons on which the system is intended to be used?
# Question: lexreq:aiact-art13-3-b-v-cq1
# Requirement: lexreq:aiact-art13-3-b-v
# Terms: aidoc-lex:measuredForGroup

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?metric ?group ?value WHERE {
  ?m dqv:isMeasurementOf ?metric ;
     dqv:computedOn ?system ;
     dqv:value ?value ;
     aidoc-lex:measuredForGroup ?group .
}
ORDER BY ?metric ?group
