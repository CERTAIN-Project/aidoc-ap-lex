# CQ: Are the limitations of performance of the high-risk AI system captured?
# Question: lexreq:aiact-art13-3-b-cq3
# Requirement: lexreq:aiact-art13-3-b
# Terms: aidoc:AISystemCapability, aidoc:hasCapability, aidoc-lex:measuredForGroup

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?capability ?limitation ?group ?value WHERE {
  ?system aidoc:hasCapability ?capability .
  ?capability rdfs:comment ?limitation .
  OPTIONAL {
    ?measurement dqv:computedOn ?system ;
                 aidoc-lex:measuredForGroup ?group ;
                 dqv:value ?value .
  }
}
