# CQ: What is the intended purpose of the high-risk AI system?
# Question: lexreq:aiact-art13-3-b-i-cq1
# Requirement: lexreq:aiact-art13-3-b-i
# Terms: aidoc:hasIntendedPurpose

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?purpose ?description WHERE {
  ?system aidoc:hasIntendedPurpose ?purpose .
  OPTIONAL { ?purpose rdfs:label ?description }
}
