# CQ: What changes to the high-risk AI system and its performance have been pre-determined by the provider at the moment of the initial conformity assessment?
# Question: lexreq:aiact-art13-3-c-cq1
# Requirement: lexreq:aiact-art13-3-c
# Terms: aidoc-lex:PredeterminedChange, aidoc-lex:concernsSystem

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?change WHERE {
  ?change a aidoc-lex:PredeterminedChange ;
          aidoc-lex:concernsSystem ?system .
}
