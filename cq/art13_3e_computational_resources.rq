# CQ: What computational and hardware resources are needed for the high-risk AI system?
# Question: lexreq:aiact-art13-3-e-cq1
# Requirement: lexreq:aiact-art13-3-e
# Terms: aidoc:HardwareComponent, aidoc:ComputationalResource, aidoc:requiresHardware, aidoc:providesComputationalResource, aidoc-lex:expectedLifetime

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
SELECT ?system ?hardware ?resource ?configuration ?lifetime WHERE {
  ?system aidoc:requiresHardware ?hardware .
  ?hardware aidoc:providesComputationalResource ?resource .
  OPTIONAL { ?resource aidoc:resourceConfiguration ?configuration }
  OPTIONAL { ?system aidoc-lex:expectedLifetime ?lifetime }
}
