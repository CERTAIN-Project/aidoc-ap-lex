# CQ: What mechanisms included within the high-risk AI system allow deployers to properly collect, store and interpret the logs in accordance with Article 12?
# Question: lexreq:aiact-art13-3-f-cq1
# Requirement: lexreq:aiact-art13-3-f
# Terms: aidoc:DataMonitoringAndLogging, aidoc:storesLogsAt, aidoc:Log, aidoc-lex:retentionPeriod

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
SELECT ?logging ?log ?store ?retention WHERE {
  ?logging a aidoc:DataMonitoringAndLogging ;
           aidoc:producesLog ?log ;
           aidoc:storesLogsAt ?store .
  OPTIONAL { ?log aidoc-lex:retentionPeriod ?retention }
}
