# CQ: What oversight measures are commensurate with the risks, level of autonomy and context of use of the high-risk AI system?
# Question: lexreq:aiact-art14-3-cq1
# Requirement: lexreq:aiact-art14-3
# Terms: aidoc-lex:addressesRisk, aidoc-lex:assignedOverseer

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?mechanism ?type ?overseer ?risk WHERE {
  ?system aidoc:hasHumanOversight ?mechanism .
  ?mechanism a ?type .
  ?type rdfs:subClassOf+ aidoc:HumanOversightMechanism .
  OPTIONAL { ?mechanism aidoc-lex:assignedOverseer ?overseer }
  OPTIONAL { ?mechanism aidoc-lex:addressesRisk ?risk }
}
ORDER BY ?type ?mechanism
