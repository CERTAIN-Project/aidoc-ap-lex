# CQ: What measures are identified and built into the high-risk AI system by the provider before it is placed on the market or put into service?
# Question: lexreq:aiact-art14-3-a-cq1
# Requirement: lexreq:aiact-art14-3-a
# Terms: aidoc-lex:ProviderOversightMeasure, aidoc:isProvidedBy

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
SELECT ?system ?provider ?measure WHERE {
  ?system aidoc:isProvidedBy ?provider ;
          aidoc:hasHumanOversight ?measure .
  ?measure a aidoc-lex:ProviderOversightMeasure .
}
