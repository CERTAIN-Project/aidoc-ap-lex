# CQ: What are the relevant capacities and limitations of the high-risk AI system?
# Question: lexreq:aiact-art14-4-a-cq1
# Requirement: lexreq:aiact-art14-4-a
# Terms: aidoc:AISystemCapability, aidoc:hasCapability

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?capability ?label ?limitation WHERE {
  ?system aidoc:hasCapability ?capability .
  ?capability rdfs:label ?label .
  OPTIONAL { ?capability rdfs:comment ?limitation }
}
