# CQ: How are natural persons enabled to intervene in the operation of the high-risk AI system or interrupt the system through a ‘stop’ button or a similar procedure that allows the system to come to a halt in a safe state?
# Question: lexreq:aiact-art14-4-e-cq1
# Requirement: lexreq:aiact-art14-4-e
# Terms: aidoc-lex:StopMechanism, aidoc-lex:assignedOverseer

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?mechanism ?overseer WHERE {
  ?system aidoc:hasHumanOversight ?mechanism .
  ?mechanism a aidoc-lex:StopMechanism .
  OPTIONAL { ?mechanism aidoc-lex:assignedOverseer ?overseer }
}
