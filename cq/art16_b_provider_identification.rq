# CQ: Is the provider’s name, registered trade name or registered trade mark, and their contact address available on all their packaging and/or accompanying documentation?
# Question: lexreq:aiact-art16-b-cq1
# Requirement: lexreq:aiact-art16-b
# Terms: aidoc:AIProvider, aidoc:isProvidedBy, aidoc-lex:contactDetails

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?provider ?name ?contact WHERE {
  ?system aidoc:isProvidedBy ?provider .
  ?provider rdfs:label ?name ;
            aidoc-lex:contactDetails ?contact .
}
