# CQ: What techniques, procedures and systematic actions are used for design control and design verification?
# Question: lexreq:aiact-art17-1-b-cq2
# Requirement: lexreq:aiact-art17-1-b
# Terms: aidoc-lex:Procedure, aidoc-lex:procedureType, aidoc-lex:DesignControl

PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?qms ?procedure ?label WHERE {
  ?qms aidoc-lex:includesDocument ?procedure .
  ?procedure a aidoc-lex:Procedure ;
             aidoc-lex:procedureType aidoc-lex:DesignControl ;
             rdfs:label ?label .
}
