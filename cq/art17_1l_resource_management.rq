# CQ: What resource management measures are included in the quality management system?
# Question: lexreq:aiact-art17-1-l-cq1
# Requirement: lexreq:aiact-art17-1-l
# Terms: aidoc-lex:Procedure, aidoc-lex:ResourceManagement

PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?qms ?procedure ?label WHERE {
  ?qms aidoc-lex:includesDocument ?procedure .
  ?procedure aidoc-lex:procedureType aidoc-lex:ResourceManagement ;
             rdfs:label ?label .
}
