# CQ: What accountability framework sets out the responsibilities of the management and other staff with regard to all the aspects listed in paragraph 1?
# Question: lexreq:aiact-art17-1-m-cq1
# Requirement: lexreq:aiact-art17-1-m
# Terms: aidoc-lex:AccountabilityFramework, aidoc-lex:accountableAgent, aidoc-lex:hasManagementSystem

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?provider ?framework ?accountable WHERE {
  ?provider aidoc-lex:hasManagementSystem ?framework .
  ?framework a aidoc-lex:AccountabilityFramework ;
             aidoc-lex:accountableAgent ?accountable .
}
