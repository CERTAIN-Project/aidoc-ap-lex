# CQ: What post-market monitoring system is established and documented that is proportionate to the nature of the AI technologies and the risks of the high-risk AI system?
# Question: lexreq:aiact-art72-1-cq1
# Requirement: lexreq:aiact-art72-1
# Terms: dpv-aiact:PostMarketMonitoringSystem, aidoc-lex:hasManagementSystem, aidoc-lex:includesDocument

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX dpv-aiact: <https://w3id.org/dpv/legal/eu/aiact#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?pmm ?document WHERE {
  ?system aidoc-lex:hasManagementSystem ?pmm .
  ?pmm a dpv-aiact:PostMarketMonitoringSystem .
  OPTIONAL { ?pmm aidoc-lex:includesDocument ?document }
}
