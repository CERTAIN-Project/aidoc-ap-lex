# CQ: What risk correction processes are in place for performing an investigation of a serious incident and the AI system?
# Question: lexreq:aiact-art73-6-cq1
# Requirement: lexreq:aiact-art73-6
# Terms: aidoc-lex:CorrectiveAction, aidoc-lex:IncidentInvestigation, dpv-aiact:SeriousIncident, aidoc-lex:assesses

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX dpv-aiact: <https://w3id.org/dpv/legal/eu/aiact#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?incident ?investigation ?system ?action WHERE {
  ?investigation a aidoc-lex:IncidentInvestigation ;
                 prov:wasInformedBy ?incident ;
                 aidoc-lex:assesses ?system .
  ?incident a dpv-aiact:SeriousIncident .
  OPTIONAL { ?action a aidoc-lex:CorrectiveAction ; prov:wasInformedBy ?investigation }
}
