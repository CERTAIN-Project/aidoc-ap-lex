# CQ: How are technology acceptance rates monitored across women, men, and non-binary individuals?
# Question: lexreq:gender-04-cq1
# Requirement: lexreq:gender-04
# Terms: aidoc-lex:TechnologyAcceptanceStudy, aidoc-lex:assesses

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?study WHERE {
  ?study a aidoc-lex:TechnologyAcceptanceStudy ;
         aidoc-lex:assesses ?system .
}
