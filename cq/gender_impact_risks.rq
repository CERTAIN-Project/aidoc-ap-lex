# CQ: What anticipated benefits and risks for gender relations were identified?
# Question: lexreq:gender-03-cq6
# Requirement: lexreq:gender-03
# Terms: aidoc-lex:GenderDisparityRisk, aidoc-lex:GenderImpactAssessment, aidoc-lex:affectsGroup, aidoc-lex:identifiesRisk, aidoc-lex:riskCategory

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?assessment ?risk ?group WHERE {
  ?assessment a aidoc-lex:GenderImpactAssessment ;
              aidoc-lex:identifiesRisk ?risk .
  ?risk aidoc-lex:riskCategory aidoc-lex:GenderDisparityRisk .
  OPTIONAL { ?risk aidoc-lex:affectsGroup ?group }
}
