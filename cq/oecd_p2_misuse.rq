# CQ: What out-of-intended-purpose, intentional-misuse, and unintentional-misuse scenarios does the AI system check for, and how are they controlled?
# Question: lexreq:oecd-p2-cq4
# Requirement: lexreq:oecd-p2
# Terms: aidoc-lex:hasForeseeableMisuse

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lex: <https://w3id.org/aidoc-ap/lex#>
PREFIX lexreq: <https://w3id.org/aidoc-ap/lex/requirements#>
PREFIX aiact: <https://w3id.org/aidoc-ap/requirements#>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?system ?misuse WHERE {
  ?system aidoc-lex:hasForeseeableMisuse ?misuse .
}
