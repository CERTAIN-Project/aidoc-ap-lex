    skos:definition "Start and end of each use of the system."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex#> .

###  https://w3id.org/aidoc-ap/lex#ReferenceDatabaseCheck
:ReferenceDatabaseCheck rdf:type skos:Concept ;
    skos:inScheme :LoggedEventTypes ;
    skos:topConceptOf :LoggedEventTypes ;
    skos:prefLabel "Reference database check"@en ;
    skos:definition "Check of input data against a reference database."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex#> .

###  https://w3id.org/aidoc-ap/lex#InputDataMatch
:InputDataMatch rdf:type skos:Concept ;
    skos:inScheme :LoggedEventTypes ;
    skos:topConceptOf :LoggedEventTypes ;
    skos:prefLabel "Input data match"@en ;
    skos:definition "Input data for which the search led to a match."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex#> .

