:ResultVerification rdf:type skos:Concept ;
    skos:inScheme :LoggedEventTypes ;
    skos:topConceptOf :LoggedEventTypes ;
    skos:prefLabel "Result verification"@en ;
    skos:definition "Verification of the results by natural persons."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex#> .

###  https://w3id.org/aidoc-ap/lex#IncidentCategories
:IncidentCategories rdf:type skos:ConceptScheme ;
    skos:prefLabel "Serious incident categories"@en ;
    skos:definition "Categories of serious incidents."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex#> ;
    dcterms:source "Regulation (EU) 2024/1689 (AI Act), Articles 3(49) and 73" .

###  https://w3id.org/aidoc-ap/lex#DeathOrHealthHarm
:DeathOrHealthHarm rdf:type skos:Concept ;
    skos:inScheme :IncidentCategories ;
    skos:topConceptOf :IncidentCategories ;
