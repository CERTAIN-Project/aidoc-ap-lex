    skos:definition "Situation that may result in a risk or a substantial modification."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex#> .

###  https://w3id.org/aidoc-ap/lex#PostMarketMonitoringEvent
:PostMarketMonitoringEvent rdf:type skos:Concept ;
    skos:inScheme :LoggedEventTypes ;
    skos:topConceptOf :LoggedEventTypes ;
    skos:prefLabel "Post-market monitoring event"@en ;
    skos:definition "Event relevant to the post-market monitoring."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex#> .

###  https://w3id.org/aidoc-ap/lex#OperationalMonitoringEvent
:OperationalMonitoringEvent rdf:type skos:Concept ;
    skos:inScheme :LoggedEventTypes ;
    skos:topConceptOf :LoggedEventTypes ;
    skos:prefLabel "Operational monitoring event"@en ;
    skos:definition "Event relevant to monitoring the operation by the deployer."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex#> .

###  https://w3id.org/aidoc-ap/lex#UsagePeriod
:UsagePeriod rdf:type skos:Concept ;
    skos:inScheme :LoggedEventTypes ;
    skos:topConceptOf :LoggedEventTypes ;
