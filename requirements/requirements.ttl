    lexreq:usesTerm aidoc:Auditor , aidoc:ChangeLog , aidoc:Dataset , aidoc:Log , aidoc:hasSourceDataset , aidoc:hasTechnicalDocumentation , aidoc:storesLogsAt ;
    lexreq:expectedEvidence "Audit trail design"@en ;
    lexreq:expectedEvidence "Traceability and logging records"@en ;
    lexreq:expectedEvidence "Training data sourcing documentation"@en ;
    lexreq:expectedEvidence "Impact log covering positive and negative outcomes"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r7-01-cq1 , lexreq:altai-r7-01-cq2 .
