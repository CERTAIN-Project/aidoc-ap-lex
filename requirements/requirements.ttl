lexreq:aiact-art9-8 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-009-0008" ;
    rdfs:label "Article 9(8)"@en ;
    lexreq:section "Article 9: Risk management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 9(8)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-9> ;
    dcterms:description "The testing of high-risk AI systems shall be performed, as appropriate, at any time throughout the development process, and, in any event, prior to their being placed on the market or put into service. Testing shall be carried out against prior defined metrics and probabilistic thresholds that are appropriate to the intended purpose of the high-risk AI system."@en ;
    lexreq:usesTerm aidoc:BuildAndIntegrationTesting , aidoc:DataTesting , aidoc:ModelEvaluation , aidoc:PerformanceMetric , aidoc:evaluationMethod , aidoc:hasAIActivity , aidoc:hasIntendedPurpose , aidoc:hasLifecycleStage , aidoc:hasPerformanceMetric ;
    lexreq:expectedEvidence "Stage-gated test schedule"@en ;
    lexreq:expectedEvidence "Pre-market validation sign-off"@en ;
    lexreq:expectedEvidence "Metrics catalogue"@en ;
    lexreq:expectedEvidence "Threshold register"@en ;
    lexreq:expectedEvidence "Release readiness checklist"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art9-8-cq1 , lexreq:aiact-art9-8-cq2 , lexreq:aiact-art9-8-cq3 , lexreq:aiact-art9-8-cq4 , lexreq:aiact-art9-8-cq5 .
lexreq:aiact-art9-8-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How is appropriate testing being defined, assessed and validated for the specific high-risk AI system?"@en .
lexreq:aiact-art9-8-cq2 a lexreq:CompetencyQuestion ; rdfs:label "Is testing being performed throughout the development process of the high-risk AI system?"@en .
lexreq:aiact-art9-8-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What testing is performed prior to the high-risk AI system being placed on the market or put into service?"@en .
lexreq:aiact-art9-8-cq4 a lexreq:CompetencyQuestion ; rdfs:label "What prior defined metrics and probabilistic thresholds are used for testing the high-risk AI system?"@en ; lexreq:formalisedBy "cq/art09_8_test_metrics.rq" .
lexreq:aiact-art9-8-cq5 a lexreq:CompetencyQuestion ; rdfs:label "How are those metrics and probabilistic thresholds appropriate to the intended purpose of the high-risk AI system?"@en .

