lexreq:aiact-art10-5-b-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What security and privacy-preserving measures are applied, including pseudonymisation?"@en ; lexreq:formalisedBy "cq/art10_5b_privacy_measures.rq" .

lexreq:aiact-art10-5-c a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-010-0005-c" ;
    rdfs:label "Article 10(5)(c)"@en ;
    lexreq:section "Article 10: Data and data governance" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 10(5), point (c)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-10> ;
