    dcterms:description "Is your AI system being trained, or was it developed, by using or processing personal data (including special categories of personal data)?"@en ;
    lexreq:usesTerm aidoc:DataMonitoringAndLogging , aidoc:DataProcessing , aidoc:DataSheet , aidoc:Dataset , aidoc:hasSourceDataset , aidoc:storesLogsAt , aidoc-lex:DataProtectionImpactAssessment , dpv:DataProtectionOfficer ;
