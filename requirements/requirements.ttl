lexreq:altai-r2-05-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What mechanisms does the AI system use to assess malicious use, misuse, and inappropriate use?"@en .
lexreq:altai-r2-05-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system define safety criticality levels for the consequences of faults or misuse?"@en .

lexreq:altai-r2-06 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r2-06" ;
    rdfs:label "Requirement 2: Technical Robustness and Safety / General Safety, item 6"@en ;
    lexreq:section "Requirement 2: Technical Robustness and Safety" ;
