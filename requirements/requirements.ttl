    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Did you consider establishing an AI ethics review board or a similar mechanism to discuss the overall accountability and ethics practices, including potential unclear grey areas?"@en ;
    lexreq:usesTerm aidoc:AIActivity , aidoc:hasStakeholder , aidoc-lex:EthicsReviewBoard ;
    lexreq:expectedEvidence "Ethics board charter or terms of reference"@en ;
    lexreq:expectedEvidence "Membership list and role descriptions"@en ;
    lexreq:expectedEvidence "Meeting minutes and decision log"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r7-05-cq1 , lexreq:altai-r7-05-cq2 .
lexreq:altai-r7-05-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system support review of accountability and ethics practices, including unclear grey areas?"@en .
lexreq:altai-r7-05-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What review board or equivalent mechanism is established or considered for this purpose in relation to the AI system?"@en .

lexreq:altai-r7-06 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r7-06" ;
    rdfs:label "Requirement 7: Accountability / Risk Management, item 6"@en ;
    lexreq:section "Requirement 7: Accountability" ;
    dcterms:source "ALTAI, Requirement 7: Accountability / Risk Management" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Did you establish a process to discuss and continuously monitor and assess the AI system's adherence to this Assessment List for Trustworthy AI (ALTAI)?\nDoes this process include identification and documentation of conflicts between the 6 aforementioned requirements or between different ethical principles and explanation of the 'trade-off' decisions made?\nDid you provide appropriate training to those involved in such a process and does this also cover the legal framework applicable to the AI system?"@en ;
    lexreq:usesTerm aidoc:AIActivity , aidoc:hasLifecycleStage , aidoc:hasRisk , aidoc-lex:Assessment , aidoc-lex:TradeOffAssessment ;
    lexreq:expectedEvidence "Periodic ALTAI review process"@en ;
    lexreq:expectedEvidence "Trade-off register or ethics decision log"@en ;
    lexreq:expectedEvidence "Assessment meeting records"@en ;
    lexreq:expectedEvidence "Training records for reviewers"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r7-06-cq1 , lexreq:altai-r7-06-cq2 , lexreq:altai-r7-06-cq3 .
lexreq:altai-r7-06-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system support continuous discussion, monitoring, and assessment of adherence to ALTAI?"@en .
lexreq:altai-r7-06-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What mechanisms identify, document, and explain conflicts or trade-offs between requirements and ethical principles?"@en ; lexreq:formalisedBy "cq/altai_r7_trade_offs.rq" .
lexreq:altai-r7-06-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system ensure that participants in this process are trained, including on the relevant legal framework?"@en .

lexreq:altai-r7-07 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r7-07" ;
    rdfs:label "Requirement 7: Accountability / Risk Management, item 7"@en ;
    lexreq:section "Requirement 7: Accountability" ;
    dcterms:source "ALTAI, Requirement 7: Accountability / Risk Management" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Did you establish a process for third parties (e.g. suppliers, end-users, subjects, distributors/vendors or workers) to report potential vulnerabilities, risks or biases in the AI system?\nDoes this process foster revision of the risk management process?"@en ;
    lexreq:usesTerm aidoc:PostMarketMonitoringActivity , aidoc:hasRisk , aidoc:hasStakeholder , aidoc-lex:ReportingChannel ;
    lexreq:expectedEvidence "Third-party reporting channel description"@en ;
    lexreq:expectedEvidence "Supplier or user reporting form"@en ;
    lexreq:expectedEvidence "Procedure linking reports to risk management updates"@en ;
    lexreq:expectedEvidence "Closed-loop corrective action records"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r7-07-cq1 , lexreq:altai-r7-07-cq2 .
lexreq:altai-r7-07-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system allow third parties to report potential vulnerabilities, risks, or biases?"@en .
lexreq:altai-r7-07-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system ensure that such reporting triggers review and revision of risk management?"@en .

lexreq:altai-r7-08 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r7-08" ;
    rdfs:label "Requirement 7: Accountability / Risk Management, item 8"@en ;
    lexreq:section "Requirement 7: Accountability" ;
