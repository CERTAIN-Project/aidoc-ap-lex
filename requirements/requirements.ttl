lexreq:aiact-art14-5 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-014-0005" ;
    rdfs:label "Article 14(5)"@en ;
    lexreq:section "Article 14: Human oversight" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 14(5)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-14> ;
    dcterms:description "For high-risk AI systems referred to in point 1(a) of Annex III, the measures referred to in paragraph 3 of this Article shall be such as to ensure that, in addition, no action or decision is taken by the deployer on the basis of the identification resulting from the system unless that identification has been separately verified and confirmed by at least two natural persons with the necessary competence, training and authority.\nThe requirement for a separate verification by at least two natural persons shall not apply to high-risk AI systems used for the purposes of law enforcement, migration, border control or asylum, where Union or national law considers the application of this requirement to be disproportionate."@en ;
    lexreq:usesTerm aidoc:AIAgent , aidoc:AIDeployer , aidoc:AISystem , aidoc:HumanOversightMechanism , aidoc:hasHumanOversight , aidoc:isDeployedBy , dpv-aiact:HighRiskAISystem-AnnexIII-1-a , aidoc-lex:justification , aidoc-lex:verifiedBy , aidoc-lex:CompetenceTraining , dpv-aiact:HumanOverseer ;
    lexreq:expectedEvidence "Dual-verification procedure"@en ;
    lexreq:expectedEvidence "Verifier authorisation records"@en ;
    lexreq:expectedEvidence "Training records"@en ;
    lexreq:expectedEvidence "Approval workflow"@en ;
    lexreq:expectedEvidence "Decision log requiring two-person confirmation"@en ;
    lexreq:expectedEvidence "Legal applicability assessment"@en ;
    lexreq:expectedEvidence "Derogation record"@en ;
    lexreq:expectedEvidence "Use-context classification"@en ;
    lexreq:expectedEvidence "Proportionality analysis"@en ;
    lexreq:expectedEvidence "Governing legal basis"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art14-5-cq1 , lexreq:aiact-art14-5-cq2 , lexreq:aiact-art14-5-cq3 .
lexreq:aiact-art14-5-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How is it ensured that no action or decision is taken by the deployer on the basis of the identification resulting from the system unless that identification has been separately verified and confirmed by at least two natural persons with the necessary competence, training and authority?"@en .
lexreq:aiact-art14-5-cq2 a lexreq:CompetencyQuestion ; rdfs:label "For what high-risk AI systems used for the purposes of law enforcement, migration, border control or asylum does the requirement for a separate verification by at least two natural persons not apply?"@en .
lexreq:aiact-art14-5-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How is it determined that the application of this requirement is disproportionate under Union or national law?"@en .

