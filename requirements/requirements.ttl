    lexreq:expectedEvidence "Oversight procedure"@en ;
    lexreq:expectedEvidence "Misuse scenario assessment"@en ;
    lexreq:expectedEvidence "Fundamental-rights risk assessment"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art14-2-cq1 , lexreq:aiact-art14-2-cq2 .
lexreq:aiact-art14-2-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What risks to health, safety or fundamental rights may emerge when the high-risk AI system is used in accordance with its intended purpose or under conditions of reasonably foreseeable misuse?"@en .
