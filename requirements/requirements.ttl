lexreq:altai-r4-02-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system use identified misunderstandings to improve explanations, documentation, or behaviour?"@en .

lexreq:altai-r4-03 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r4-03" ;
    rdfs:label "Requirement 4: Transparency / Communication, item 3"@en ;
