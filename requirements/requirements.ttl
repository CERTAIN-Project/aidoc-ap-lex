lexreq:altai-r1-07-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What technical and organisational controls does the AI system implement to manage its self-learning or autonomous behaviour?"@en .
lexreq:altai-r1-07-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system verify that emergency stop and override procedures work effectively?"@en .

lexreq:altai-r2-01 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r2-01" ;
    rdfs:label "Requirement 2: Technical Robustness and Safety / Resilience to Attack and Security, item 1"@en ;
    lexreq:section "Requirement 2: Technical Robustness and Safety" ;
    dcterms:source "ALTAI, Requirement 2: Technical Robustness and Safety / Resilience to Attack and Security" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Could the AI system have adversarial, critical or damaging effects (e.g. to human or societal safety) in case of risks or threats such as design or technical faults, defects, outages, attacks, misuse, inappropriate or malicious use?"@en ;
    lexreq:usesTerm aidoc:AISystem , aidoc:Standard , aidoc:affects , aidoc:appliesStandard , aidoc:hasRisk ;
    lexreq:expectedEvidence "Threat model and safety impact assessment"@en ;
    lexreq:expectedEvidence "Security standards compliance matrix"@en ;
    lexreq:expectedEvidence "Cybersecurity certification records or gap assessment"@en ;
    lexreq:expectedEvidence "Risk register linking security failures to harm scenarios"@en ;
    lexreq:expectedEvidence "Requirement 2: Technical Robustness and Safety / Resilience to Attack and Security"@en ;
    lexreq:expectedEvidence "Is the AI system certified for cybersecurity (e.g. the certification scheme created by the Cybersecurity Act in Europe) or is it compliant with specific security standards?"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r2-01-cq1 , lexreq:altai-r2-01-cq2 , lexreq:altai-r2-01-cq3 .
lexreq:altai-r2-01-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system identify and control adversarial, critical, or damaging effects arising from faults, outages, attacks, misuse, or malicious use?"@en .
lexreq:altai-r2-01-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What cybersecurity certifications, assurance schemes, or security standards does the AI system meet?"@en .
lexreq:altai-r2-01-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system maintain a security posture proportionate to its human and societal safety impacts?"@en .

lexreq:altai-r2-02 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r2-02" ;
    rdfs:label "Requirement 2: Technical Robustness and Safety / Resilience to Attack and Security, item 2"@en ;
    lexreq:section "Requirement 2: Technical Robustness and Safety" ;
    dcterms:source "ALTAI, Requirement 2: Technical Robustness and Safety / Resilience to Attack and Security" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "How exposed is the AI system to cyber-attacks?\nDid you assess potential forms of attacks to which the AI system could be vulnerable?\nDid you consider different types of vulnerabilities and potential entry points for attacks such as:\nData poisoning (i.e. manipulation of training data);\nModel evasion (i.e. classifying the data according to the attacker's will);\nModel inversion (i.e. infer the model parameters)"@en ;
    lexreq:usesTerm aidoc:AIModel , aidoc:Dataset , aidoc:SoftwareComponent , aidoc:hasRisk , aidoc:hasSoftwareComponent , aidoc:usesTrainingData ;
    lexreq:expectedEvidence "Attack surface inventory"@en ;
    lexreq:expectedEvidence "Adversarial ML threat analysis"@en ;
    lexreq:expectedEvidence "Vulnerability assessment report"@en ;
    lexreq:expectedEvidence "Documented mitigations for poisoning, evasion, and inversion risks"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r2-02-cq1 , lexreq:altai-r2-02-cq2 , lexreq:altai-r2-02-cq3 .
lexreq:altai-r2-02-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system assess exposure to cyber-attacks across its data, model, software, and deployment interfaces?"@en .
lexreq:altai-r2-02-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What attack scenarios and entry points does the AI system evaluate, including data poisoning, model evasion, and model inversion?"@en .
lexreq:altai-r2-02-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system prioritise and remediate vulnerabilities based on likelihood, exploitability, and impact?"@en .

lexreq:altai-r2-03 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r2-03" ;
    rdfs:label "Requirement 2: Technical Robustness and Safety / Resilience to Attack and Security, item 3"@en ;
