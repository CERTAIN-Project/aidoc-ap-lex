lexreq:altai-r5-08-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What mechanisms does the AI system use to verify that Universal Design requirements remain addressed throughout its lifecycle?"@en .

lexreq:altai-r5-09 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r5-09" ;
    rdfs:label "Requirement 5: Diversity, Non-discrimination and Fairness / Accessibility and Universal Design, item 9"@en ;
    lexreq:section "Requirement 5: Diversity, Non-discrimination and Fairness" ;
    dcterms:source "ALTAI, Requirement 5: Diversity, Non-discrimination and Fairness / Accessibility and Universal Design" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Did you take the impact of the AI system on the potential end-users and/or subjects into account?\nDid you assess whether the team involved in building the AI system engaged with the possible target end-users and/or subjects?\nDid you assess whether there could be groups who might be disproportionately affected by the outcomes of the AI system?\nDid you assess the risk of the possible unfairness of the system onto the end-user's or subject's communities?"@en ;
    lexreq:usesTerm aidoc:AIActivity , aidoc:affects , aidoc:hasRisk , aidoc:hasStakeholder , aidoc-lex:StakeholderConsultation ;
    lexreq:expectedEvidence "Stakeholder engagement plan and records"@en ;
    lexreq:expectedEvidence "Impact assessment by user group and community"@en ;
    lexreq:expectedEvidence "Minutes or summaries from co-design sessions"@en ;
    lexreq:expectedEvidence "Mitigation plan for disproportionate impacts"@en ;
    lexreq:expectedEvidence "Requirement 5: Diversity, Non-discrimination and Fairness / Stakeholder Participation"@en ;
    lexreq:expectedEvidence "Did you consider a mechanism to include the participation of the widest range of possible stakeholders in the AI system’s design and development?"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r5-09-cq1 , lexreq:altai-r5-09-cq2 , lexreq:altai-r5-09-cq3 .
lexreq:altai-r5-09-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system assess impacts on potential end-users, subjects, and their communities?"@en .
lexreq:altai-r5-09-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What mechanisms does the AI system use to engage target end-users, subjects, and other stakeholders during design and development?"@en .
lexreq:altai-r5-09-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system identify and address disproportionate effects and community-level unfairness risks?"@en .

lexreq:altai-r6-01 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r6-01" ;
    rdfs:label "Requirement 6: Societal and Environmental Well-being / Environmental Well-being, item 1"@en ;
    lexreq:section "Requirement 6: Societal and Environmental Well-being" ;
    dcterms:source "ALTAI, Requirement 6: Societal and Environmental Well-being / Environmental Well-being" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Are there potential negative impacts of the AI system on the environment?\nWhich potential impact(s) do you identify?"@en ;
    lexreq:usesTerm aidoc:AIActivity , aidoc:ComputationalResource , aidoc:affects , aidoc:providesComputationalResource , aidoc:resourceConfiguration , aidoc-lex:ImpactAssessment , aidoc:PerformanceMetric ;
    lexreq:expectedEvidence "Environmental impact assessment"@en ;
    lexreq:expectedEvidence "Energy and compute usage logs"@en ;
    lexreq:expectedEvidence "Carbon accounting methodology"@en ;
    lexreq:expectedEvidence "Sustainability improvement plan"@en ;
    lexreq:expectedEvidence "Requirement 6: Societal and Environmental Well-being / Environmental Well-being"@en ;
    lexreq:expectedEvidence "Where possible, did you establish mechanisms to evaluate the environmental impact of the AI system’s development, deployment and/or use (for example, the amount of energy used and carbon emissions)?"@en ;
    lexreq:expectedEvidence "Did you define measures to reduce the environmental impact of the AI system throughout its lifecycle?"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r6-01-cq1 , lexreq:altai-r6-01-cq2 , lexreq:altai-r6-01-cq3 .
lexreq:altai-r6-01-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What potential negative environmental impacts does the AI system identify?"@en .
lexreq:altai-r6-01-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system evaluate environmental impacts of development, deployment, and use, including energy use and carbon emissions where possible?"@en ; lexreq:formalisedBy "cq/altai_r6_environmental_impact.rq" .
lexreq:altai-r6-01-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What measures does the AI system implement to reduce environmental impact throughout its lifecycle?"@en .

lexreq:altai-r6-02 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r6-02" ;
