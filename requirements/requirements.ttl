lexreq:altai-r4-01 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r4-01" ;
    rdfs:label "Requirement 4: Transparency / Traceability, item 1"@en ;
    lexreq:section "Requirement 4: Transparency" ;
    dcterms:source "ALTAI, Requirement 4: Transparency / Traceability" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Did you put in place measures that address the traceability of the AI system during its entire lifecycle?\nDid you put in place measures to continuously assess the quality of the input data to the AI system?\nCan you trace back which data was used by the AI system to make a certain decision(s) or recommendation(s)?\nCan you trace back which AI model or rules led to the decision(s) or recommendation(s) of the AI system?\nDid you put in place measures to continuously assess the quality of the output(s) of the AI system?\nDid you put adequate logging practices in place to record the decision(s) or recommendation(s) of the AI system?"@en ;
    lexreq:usesTerm aidoc:AIModel , aidoc:DataMonitoringAndLogging , aidoc:Dataset , aidoc:Log , aidoc:hasSourceDataset , aidoc:hasTechnicalDocumentation , aidoc:logsActivity , aidoc:storesLogsAt ;
    lexreq:expectedEvidence "Traceability matrix"@en ;
    lexreq:expectedEvidence "Data lineage records"@en ;
    lexreq:expectedEvidence "Model lineage and version history"@en ;
    lexreq:expectedEvidence "Decision logs and output quality reports"@en ;
    lexreq:expectedEvidence "Runbook for logging and trace retrieval"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r4-01-cq1 , lexreq:altai-r4-01-cq2 , lexreq:altai-r4-01-cq3 .
lexreq:altai-r4-01-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system maintain traceability across its full lifecycle?"@en .
lexreq:altai-r4-01-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What mechanisms allow the AI system to trace the input data, model or rule set, and outputs involved in each decision or recommendation?"@en .
lexreq:altai-r4-01-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system continuously assess input quality, output quality, and logging practices?"@en .

