lexreq:altai-r2-04-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What mechanisms does the AI system use to continuously measure, review, and update its risk profile?"@en .
lexreq:altai-r2-04-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system communicate existing or potential risks to end-users and subjects?"@en .

lexreq:altai-r2-05 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r2-05" ;
    rdfs:label "Requirement 2: Technical Robustness and Safety / General Safety, item 5"@en ;
    lexreq:section "Requirement 2: Technical Robustness and Safety" ;
    dcterms:source "ALTAI, Requirement 2: Technical Robustness and Safety / General Safety" ;
