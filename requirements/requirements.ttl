lexreq:altai-r7-01-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What records does the AI system maintain so that internal or external parties can reconstruct relevant decisions and lifecycle actions?"@en .

lexreq:altai-r7-02 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r7-02" ;
    rdfs:label "Requirement 7: Accountability / Auditability, item 2"@en ;
