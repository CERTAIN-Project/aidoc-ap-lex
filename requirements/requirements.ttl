lexreq:aiact-art15-4 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-015-0004" ;
    rdfs:label "Article 15(4)"@en ;
    lexreq:section "Article 15: Accuracy, robustness and cybersecurity" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 15(4)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-15> ;
    dcterms:description "High-risk AI systems shall be as resilient as possible regarding errors, faults or inconsistencies that may occur within the system or the environment in which the system operates, in particular due to their interaction with natural persons or other systems. Technical and organisational measures shall be taken in this regard.\nThe robustness of high-risk AI systems may be achieved through technical redundancy solutions, which may include backup or fail-safe plans.\nHigh-risk AI systems that continue to learn after being placed on the market or put into service shall be developed in such a way as to eliminate or reduce as far as possible the risk of possibly biased outputs influencing input for future operations (feedback loops), and as to ensure that any such feedback loops are duly addressed with appropriate mitigation measures."@en ;
    lexreq:usesTerm aidoc:AIActivity , aidoc:AISystem , aidoc:ModelEvaluation , aidoc:ModelVersioning , aidoc:PostMarketMonitoringActivity , aidoc:PostMarketPerformanceEvaluationActivity , aidoc:SoftwareComponent , aidoc:dependsOn , aidoc:hasRisk , aidoc:hasSoftwareComponent , aidoc-lex:ResilienceMeasure , aidoc-lex:RiskControlMeasure , aidoc-lex:FeedbackLoopRisk , aidoc-lex:BiasMitigationMeasure ;
    lexreq:expectedEvidence "Fault-tolerance testing"@en ;
    lexreq:expectedEvidence "Robustness report"@en ;
    lexreq:expectedEvidence "Failure-mode analysis"@en ;
    lexreq:expectedEvidence "Interaction-risk assessment"@en ;
    lexreq:expectedEvidence "Resilience validation results"@en ;
    lexreq:expectedEvidence "Control matrix"@en ;
    lexreq:expectedEvidence "Resilience controls documentation"@en ;
    lexreq:expectedEvidence "Governance procedures"@en ;
    lexreq:expectedEvidence "Technical safeguard implementation records, Continuous-learning controls"@en ;
    lexreq:expectedEvidence "Feedback-loop risk assessment"@en ;
    lexreq:expectedEvidence "Post-market monitoring records"@en ;
    lexreq:expectedEvidence "Mitigation plan"@en ;
    lexreq:expectedEvidence "Drift and bias monitoring reports"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art15-4-cq1 , lexreq:aiact-art15-4-cq2 , lexreq:aiact-art15-4-cq3 , lexreq:aiact-art15-4-cq4 , lexreq:aiact-art15-4-cq5 , lexreq:aiact-art15-4-cq6 , lexreq:aiact-art15-4-cq7 .
lexreq:aiact-art15-4-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What errors, faults or inconsistencies may occur within the high-risk AI system or the environment in which it operates?"@en .
lexreq:aiact-art15-4-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How is the high-risk AI system as resilient as possible regarding errors, faults or inconsistencies?"@en .
lexreq:aiact-art15-4-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What technical and organisational measures are taken in this regard?"@en .
lexreq:aiact-art15-4-cq4 a lexreq:CompetencyQuestion ; rdfs:label "What technical redundancy solutions are used to achieve the robustness of the high-risk AI system?"@en .
lexreq:aiact-art15-4-cq5 a lexreq:CompetencyQuestion ; rdfs:label "What backup or fail-safe plans are included?"@en ; lexreq:formalisedBy "cq/art15_4_fail_safe.rq" .
