lexreq:altai-r6-02-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What mechanisms linked to the AI system ensure that impacted workers and their representatives are informed and consulted before its introduction?"@en ; lexreq:formalisedBy "cq/altai_r6_worker_consultation.rq" .

lexreq:altai-r6-03 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r6-03" ;
    rdfs:label "Requirement 6: Societal and Environmental Well-being / Impact on Work and Skills, item 3"@en ;
    lexreq:section "Requirement 6: Societal and Environmental Well-being" ;
    dcterms:source "ALTAI, Requirement 6: Societal and Environmental Well-being / Impact on Work and Skills" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Did you adopt measures to ensure that the impacts of the AI system on human work are well understood?\nDid you ensure that workers understand how the AI system operates, which capabilities it has and which it does not have?"@en ;
    lexreq:usesTerm aidoc:AISystemCapability , aidoc:TransparencyMeasure , aidoc:hasCapability , aidoc:hasStakeholder ;
    lexreq:expectedEvidence "Worker training material"@en ;
    lexreq:expectedEvidence "Capability and limitation documentation"@en ;
    lexreq:expectedEvidence "Internal briefings or FAQs for employees"@en ;
    lexreq:expectedEvidence "Survey results on workforce understanding"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r6-03-cq1 , lexreq:altai-r6-03-cq2 .
lexreq:altai-r6-03-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system make its impacts on human work understandable to the organisation and workforce?"@en .
lexreq:altai-r6-03-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What mechanisms ensure that workers understand how the AI system operates, including what it can and cannot do?"@en .

lexreq:altai-r6-04 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r6-04" ;
    rdfs:label "Requirement 6: Societal and Environmental Well-being / Impact on Work and Skills, item 4"@en ;
    lexreq:section "Requirement 6: Societal and Environmental Well-being" ;
    dcterms:source "ALTAI, Requirement 6: Societal and Environmental Well-being / Impact on Work and Skills" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Could the AI system create the risk of de-skilling of the workforce?\nDid you take measures to counteract de-skilling risks?"@en ;
    lexreq:usesTerm aidoc:affects , aidoc:hasStakeholder , aidoc-lex:ImpactAssessment , aidoc-lex:CompetenceTraining ;
    lexreq:expectedEvidence "Skill impact assessment"@en ;
    lexreq:expectedEvidence "Workforce development plan"@en ;
    lexreq:expectedEvidence "Re-skilling and up-skilling curriculum"@en ;
    lexreq:expectedEvidence "Training attendance and completion records"@en ;
    lexreq:expectedEvidence "Requirement 6: Societal and Environmental Well-being / Impact on Work and Skills"@en ;
    lexreq:expectedEvidence "Does the system promote or require new (digital) skills?"@en ;
    lexreq:expectedEvidence "Did you provide training opportunities and materials for re- and up-skilling?"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r6-04-cq1 , lexreq:altai-r6-04-cq2 , lexreq:altai-r6-04-cq3 .
lexreq:altai-r6-04-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system identify and manage risks of workforce de-skilling?"@en .
lexreq:altai-r6-04-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What measures linked to the AI system counteract de-skilling risks?"@en .
lexreq:altai-r6-04-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What new skills does the AI system require or promote, and how are re-skilling and up-skilling opportunities supported?"@en .

lexreq:altai-r6-05 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r6-05" ;
    rdfs:label "Requirement 6: Societal and Environmental Well-being / Impact on Society at large or Democracy, item 5"@en ;
    lexreq:section "Requirement 6: Societal and Environmental Well-being" ;
    dcterms:source "ALTAI, Requirement 6: Societal and Environmental Well-being / Impact on Society at large or Democracy" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Could the AI system have a negative impact on society at large or democracy?\nDid you assess the societal impact of the AI system’s use beyond the (end-)user and subject, such as potentially indirectly affected stakeholders or society at large?\nDid you take action to minimize potential societal harm of the AI system?\nDid you take measures that ensure that the AI system does not negatively impact democracy?"@en ;
    lexreq:usesTerm aidoc:TransparencyMeasure , aidoc:affects , aidoc:hasRisk , aidoc:hasStakeholder , aidoc-lex:ImpactAssessment ;
    lexreq:expectedEvidence "Societal impact assessment"@en ;
    lexreq:expectedEvidence "Democracy risk assessment or misuse analysis"@en ;
    lexreq:expectedEvidence "Mitigation actions for wider societal harms"@en ;
    lexreq:expectedEvidence "Monitoring indicators for public-interest risks"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r6-05-cq1 , lexreq:altai-r6-05-cq2 , lexreq:altai-r6-05-cq3 .
lexreq:altai-r6-05-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How could the AI system negatively affect society at large or democracy?"@en .
lexreq:altai-r6-05-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system assess societal impacts beyond immediate end-users or subjects, including indirectly affected stakeholders?"@en .
lexreq:altai-r6-05-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What measures does the AI system implement to minimise societal harm and protect democratic processes?"@en .

lexreq:altai-r7-01 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r7-01" ;
