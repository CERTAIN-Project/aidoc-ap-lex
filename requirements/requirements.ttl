    lexreq:expectedEvidence "Measurement methodology documentation"@en ;
    lexreq:expectedEvidence "Performance evaluation protocol"@en ;
    lexreq:expectedEvidence "Standards mapping"@en ;
    lexreq:expectedEvidence "Stakeholder consultation records"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art15-2-cq1 , lexreq:aiact-art15-2-cq2 .
lexreq:aiact-art15-2-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What benchmarks and measurement methodologies are developed by the Commission to measure the appropriate levels of accuracy and robustness and any other relevant performance metrics?"@en .
lexreq:aiact-art15-2-cq2 a lexreq:CompetencyQuestion ; rdfs:label "Are these benchmarks and measurement methodologies developed by the Commission to measure the appropriate levels of accuracy and robustness and any other relevant performance metrics being implemented in the AI system?"@en .

