    lexreq:section "Requirement 5: Diversity, Non-discrimination and Fairness" ;
    dcterms:source "ALTAI, Requirement 5: Diversity, Non-discrimination and Fairness / Avoidance of Unfair Bias" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Is your definition of fairness commonly used and implemented in any phase of the process of setting up the AI system?\nDid you consider other definitions of fairness before choosing this one?\nDid you consult with the impacted communities about the correct definition of fairness, i.e. representatives of elderly persons or persons with disabilities?\nDid you ensure a quantitative analysis or metrics to measure and test the applied definition of fairness?\nDid you establish mechanisms to ensure fairness in your AI system?"@en ;
    lexreq:usesTerm aidoc:ModelEvaluation , aidoc:PerformanceMetric , aidoc:affects , aidoc:hasPerformanceMetric , aidoc:hasStakeholder ;
    lexreq:expectedEvidence "Fairness rationale document"@en ;
    lexreq:expectedEvidence "Community consultation records"@en ;
    lexreq:expectedEvidence "Fairness metric specification and evaluation results"@en ;
    lexreq:expectedEvidence "Ongoing fairness governance procedure"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r5-05-cq1 , lexreq:altai-r5-05-cq2 , lexreq:altai-r5-05-cq3 .
lexreq:altai-r5-05-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What definition of fairness does the AI system implement, and where in the system is it operationalised?"@en .
lexreq:altai-r5-05-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system justify the chosen fairness definition against alternative definitions?"@en .
lexreq:altai-r5-05-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system incorporate community input, quantitative metrics, and control mechanisms to test and ensure fairness?"@en .

lexreq:altai-r5-06 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r5-06" ;
    rdfs:label "Requirement 5: Diversity, Non-discrimination and Fairness / Accessibility and Universal Design, item 6"@en ;
    lexreq:section "Requirement 5: Diversity, Non-discrimination and Fairness" ;
    dcterms:source "ALTAI, Requirement 5: Diversity, Non-discrimination and Fairness / Accessibility and Universal Design" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Did you ensure that the AI system corresponds to the variety of preferences and abilities in society?"@en ;
    lexreq:usesTerm aidoc:Interface , aidoc:affects , aidoc:hasStakeholder , aidoc-lex:AccessibilityAssessment ;
    lexreq:expectedEvidence "Inclusive design requirements"@en ;
    lexreq:expectedEvidence "Persona set covering diverse abilities and preferences"@en ;
    lexreq:expectedEvidence "Usability results across diverse user groups"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r5-06-cq1 , lexreq:altai-r5-06-cq2 .
lexreq:altai-r5-06-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system accommodate the variety of user preferences and abilities present in society?"@en .
lexreq:altai-r5-06-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What design or evaluation mechanisms does the AI system use to verify that it serves diverse user capabilities?"@en .

lexreq:altai-r5-07 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r5-07" ;
    rdfs:label "Requirement 5: Diversity, Non-discrimination and Fairness / Accessibility and Universal Design, item 7"@en ;
    lexreq:section "Requirement 5: Diversity, Non-discrimination and Fairness" ;
    dcterms:source "ALTAI, Requirement 5: Diversity, Non-discrimination and Fairness / Accessibility and Universal Design" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Did you assess whether the AI system's user interface is usable by those with special needs or disabilities or those at risk of exclusion?\nDid you ensure that information about, and the AI system's user interface of, the AI system is accessible and usable also to users of assistive technologies (such as screen readers)?\nDid you involve or consult with end-users or subjects in need for assistive technology during the planning and development phase of the AI system?"@en ;
    lexreq:usesTerm aidoc:Interface , aidoc:Standard , aidoc:appliesStandard , aidoc:hasInterface , aidoc:hasStakeholder , aidoc-lex:AccessibilityMeasure ;
    lexreq:expectedEvidence "Accessibility audit report"@en ;
    lexreq:expectedEvidence "Assistive technology test results"@en ;
    lexreq:expectedEvidence "Consultation notes with users with disabilities"@en ;
    lexreq:expectedEvidence "WCAG or accessibility conformance mapping"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r5-07-cq1 , lexreq:altai-r5-07-cq2 , lexreq:altai-r5-07-cq3 .
lexreq:altai-r5-07-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system ensure that its interface is usable by people with disabilities or at risk of exclusion?"@en .
lexreq:altai-r5-07-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What makes the AI system information and interface accessible to assistive technologies such as screen readers?"@en .
lexreq:altai-r5-07-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system incorporate input from users needing assistive technology during planning and development?"@en .

lexreq:altai-r5-08 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r5-08" ;
    rdfs:label "Requirement 5: Diversity, Non-discrimination and Fairness / Accessibility and Universal Design, item 8"@en ;
