lexreq:altai-r7-02-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What access, documentation, and controls does the AI system provide to enable independent auditors to assess it?"@en .

lexreq:altai-r7-03 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r7-03" ;
