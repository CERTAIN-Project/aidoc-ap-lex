    lexreq:expectedEvidence "Privileged-access procedure"@en ;
    lexreq:expectedEvidence "Audit trail"@en ;
    lexreq:expectedEvidence "Security policy"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art10-5-c-cq1 , lexreq:aiact-art10-5-c-cq2 , lexreq:aiact-art10-5-c-cq3 .
lexreq:aiact-art10-5-c-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What measures ensure that the special categories of personal data are secured and protected?"@en .
lexreq:aiact-art10-5-c-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What safeguards, controls and access documentation apply to those data?"@en .
lexreq:aiact-art10-5-c-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How is access restricted to authorised persons with appropriate confidentiality obligations?"@en ; lexreq:formalisedBy "cq/art10_5c_access_restriction.rq" .

