lexreq:aiact-art17-4 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-017-0004" ;
    rdfs:label "Article 17(4)"@en ;
    lexreq:section "Article 17: Quality management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 17(4)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-17> ;
    dcterms:description "For providers that are financial institutions subject to requirements regarding their internal governance, arrangements or processes under Union financial services law, the obligation to put in place a quality management system, with the exception of paragraph 1, points (g), (h) and (i) of this Article, shall be deemed to be fulfilled by complying with the rules on internal governance arrangements or processes pursuant to the relevant Union financial services law. To that end, any harmonised standards referred to in Article 40 shall be taken into account."@en ;
    lexreq:usesTerm aidoc:AIProvider , aidoc:Standard , aidoc:appliesStandard , aidoc-lex:FinancialInstitution ;
    lexreq:expectedEvidence "Harmonised standards register"@en ;
    lexreq:expectedEvidence "Standards applicability assessment"@en ;
    lexreq:expectedEvidence "Standards implementation matrix"@en ;
    lexreq:expectedEvidence "Governance review record"@en ;
