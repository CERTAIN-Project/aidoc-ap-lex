    lexreq:expectedEvidence "Dataset composition report"@en ;
    lexreq:expectedEvidence "Team composition matrix"@en ;
    lexreq:expectedEvidence "Subgroup evaluation results"@en ;
    lexreq:expectedEvidence "Governance process document"@en ;
    lexreq:expectedEvidence "Explainability documentation"@en ;
    lexreq:expectedEvidence "Audit log"@en ;
