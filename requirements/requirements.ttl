    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Did you ensure that Universal Design principles are taken into account during every step of the planning and development process, if applicable?"@en ;
    lexreq:usesTerm aidoc:AIActivity , aidoc:Interface , aidoc:hasLifecycleStage , aidoc-lex:AccessibilityMeasure ;
