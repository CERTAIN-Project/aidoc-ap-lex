lexreq:altai-r2-09-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system communicate expected accuracy levels and performance limitations to end-users and subjects?"@en .

lexreq:altai-r2-10 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
