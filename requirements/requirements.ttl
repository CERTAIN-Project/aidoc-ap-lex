lexreq:aiact-art15-4-cq7 a lexreq:CompetencyQuestion ; rdfs:label "What mitigation measures address such feedback loops?"@en .

lexreq:aiact-art15-5 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-015-0005" ;
    rdfs:label "Article 15(5)"@en ;
    lexreq:section "Article 15: Accuracy, robustness and cybersecurity" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 15(5)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-15> ;
    dcterms:description "High-risk AI systems shall be resilient against attempts by unauthorised third parties to alter their use, outputs or performance by exploiting system vulnerabilities.\nThe technical solutions aiming to ensure the cybersecurity of high-risk AI systems shall be appropriate to the relevant circumstances and the risks.\nThe technical solutions to address AI specific vulnerabilities shall include, where appropriate, measures to prevent, detect, respond to, resolve and control for attacks trying to manipulate the training data set (data poisoning), or pre-trained components used in training (model poisoning), inputs designed to cause the AI model to make a mistake (adversarial examples or model evasion), confidentiality attacks or model flaws."@en ;
    lexreq:usesTerm aidoc:AISystem , aidoc:Dataset , aidoc:hasRisk , aidoc:hasSourceDataset , vair:SecurityMeasure , aidoc-lex:RiskControlMeasure ;
    lexreq:expectedEvidence "Threat model"@en ;
    lexreq:expectedEvidence "Vulnerability assessment"@en ;
    lexreq:expectedEvidence "Penetration test report"@en ;
    lexreq:expectedEvidence "Security controls documentation"@en ;
    lexreq:expectedEvidence "Incident-response records, cybersecurity architecture"@en ;
    lexreq:expectedEvidence "Risk-based security design"@en ;
    lexreq:expectedEvidence "Security control selection rationale"@en ;
    lexreq:expectedEvidence "Contextual risk analysis, poisoning-resilience tests"@en ;
    lexreq:expectedEvidence "Adversarial robustness tests"@en ;
    lexreq:expectedEvidence "Confidentiality controls"@en ;
    lexreq:expectedEvidence "Model assurance report"@en ;
    lexreq:expectedEvidence "Vulnerability remediation records"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art15-5-cq1 , lexreq:aiact-art15-5-cq2 , lexreq:aiact-art15-5-cq3 , lexreq:aiact-art15-5-cq4 , lexreq:aiact-art15-5-cq5 , lexreq:aiact-art15-5-cq6 .
lexreq:aiact-art15-5-cq1 a lexreq:CompetencyQuestion ; rdfs:label "Does the AI system have security measures in place for remaining resilient against attempts by unauthorised third parties to alter their use, outputs or performance by exploiting system vulnerabilities?"@en .
lexreq:aiact-art15-5-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How is the high-risk AI system resilient against those attempts?"@en .
lexreq:aiact-art15-5-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What technical solutions ensure the cybersecurity of the high-risk AI system?"@en .
lexreq:aiact-art15-5-cq4 a lexreq:CompetencyQuestion ; rdfs:label "How are those technical solutions appropriate to the relevant circumstances and the risks?"@en .
lexreq:aiact-art15-5-cq5 a lexreq:CompetencyQuestion ; rdfs:label "What technical solutions address AI specific vulnerabilities?"@en .
lexreq:aiact-art15-5-cq6 a lexreq:CompetencyQuestion ; rdfs:label "What measures are used to prevent, detect, respond to, resolve and control attacks trying to manipulate the training data set, pre-trained components used in training, inputs designed to cause the AI model to make a mistake, confidentiality attacks or model flaws?"@en ; lexreq:formalisedBy "cq/art15_5_attack_measures.rq" .

