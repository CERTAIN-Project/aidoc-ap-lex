@prefix lexreq: <https://w3id.org/aidoc-ap/lex/requirements#> .
@prefix aiact: <https://w3id.org/aidoc-ap/requirements#> .
@prefix aidoc: <https://w3id.org/aidoc-ap#> .
@prefix aidoc-lex: <https://w3id.org/aidoc-ap/lex#> .
@prefix vair: <https://w3id.org/vair#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix airo: <https://w3id.org/airo#> .
@prefix dpv-aiact: <https://w3id.org/dpv/legal/eu/aiact#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

################################################################################
# Metadata
################################################################################
<https://w3id.org/aidoc-ap/lex/requirements> a owl:Ontology ;
    dcterms:title "AIDOC-AP LEX Requirements"@en ;
    dcterms:description "Legal and ethical requirements for AI systems with competency questions, the ontology terms that answer them and the evidence an organisation is expected to keep. Legal requirements cover the obligations of providers and deployers in Articles 9 to 17, 72 and 73 of the EU AI Act (Regulation (EU) 2024/1689), worded as in the AI Act Service Desk of the European Commission at the time of the analysis. Ethical requirements cover the Assessment List for Trustworthy AI (ALTAI), the OECD AI Principles and the gender requirements of CERTAIN deliverable D3.2 (Ethical considerations of AI compliance)."@en ;
    dcterms:creator [ rdf:type foaf:Person ; foaf:name "Fabian Kovac" ; foaf:organization "University of Applied Sciences St. Pölten" ] ,
                    [ rdf:type foaf:Person ; foaf:name "Konstantinos Amplianitis" ; foaf:mbox <mailto:konstantinos.amplianitis@ucd.ie> ; foaf:organization "University College Dublin" ] ,
                    [ rdf:type foaf:Person ; foaf:name "Sebastian Neumaier" ; foaf:mbox <mailto:sebastian.neumaier@ustp.at> ; foaf:organization "University of Applied Sciences St. Pölten" ] ,
                    [ rdf:type foaf:Person ; foaf:name "Tobias Dam" ; foaf:organization "University of Applied Sciences St. Pölten" ] ;
    dcterms:created "2026-10-28"^^xsd:date ;
    dcterms:modified "2026-10-28"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1689/oj> , <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> , <https://oecd.ai/en/ai-principles> , <https://certain-project.eu/wp-content/uploads/2026/02/CERTAIN_WP3_D3.2_Ethical-considerations-of-AI-compliance_V1.0-delivered.pdf> ;
    vann:preferredNamespacePrefix "lexreq" ;
    vann:preferredNamespaceUri "https://w3id.org/aidoc-ap/lex/requirements#" ;
    rdfs:seeAlso <https://w3id.org/aidoc-ap/lex#> , <https://w3id.org/aidoc-ap/requirements> ;
    owl:versionInfo "1.0" .

lexreq: a skos:ConceptScheme ;
    skos:prefLabel "AIDOC-AP LEX requirements"@en ;
    skos:definition "Legal and ethical requirements for AI systems, each with competency questions, the ontology terms that answer them and the expected evidence."@en .

################################################################################
# Schema
################################################################################
lexreq:Requirement a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Requirement"@en ;
    rdfs:comment "A legal or ethical requirement for an AI system: a paragraph or point of an AI Act article, an ALTAI assessment item, an OECD AI principle or a gender requirement of CERTAIN D3.2."@en ;
    rdfs:subClassOf aiact:Requirement ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex/requirements> .

lexreq:CompetencyQuestion a owl:Class ;
    rdfs:subClassOf aiact:CompetencyQuestion ;
    rdfs:label "Competency question"@en ;
    rdfs:comment "A question that the documentation of an AI system must answer to show that a requirement is met."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex/requirements> .

lexreq:framework a owl:ObjectProperty ;
    rdfs:label "framework"@en ;
    rdfs:comment "The legal act or ethical framework that the requirement comes from."@en ;
    rdfs:domain lexreq:Requirement ; rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex/requirements> .

lexreq:section a owl:DatatypeProperty ;
    rdfs:label "section"@en ;
    rdfs:comment "Article, requirement, principle or section of the framework that groups the requirement."@en ;
    rdfs:domain lexreq:Requirement ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex/requirements> .

lexreq:usesTerm a owl:ObjectProperty ;
    rdfs:label "uses term"@en ;
    rdfs:comment "An ontology term of AIDOC-AP, AIDOC-AP LEX or a reused vocabulary that is needed to answer the competency questions of the requirement."@en ;
    rdfs:domain lexreq:Requirement ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex/requirements> .

lexreq:expectedEvidence a owl:DatatypeProperty ;
    rdfs:label "expected evidence"@en ;
    rdfs:comment "An artefact or record that an organisation is expected to keep as evidence that the requirement is met."@en ;
    rdfs:domain lexreq:Requirement ; rdfs:range rdf:langString ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex/requirements> .

lexreq:normativeSource a owl:DatatypeProperty ;
    rdfs:label "normative source"@en ;
    rdfs:comment "A normative or methodological source that shaped the requirement."@en ;
    rdfs:domain lexreq:Requirement ; rdfs:range rdf:langString ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex/requirements> .

lexreq:formalisedBy a owl:DatatypeProperty ;
    rdfs:label "formalised by"@en ;
    rdfs:comment "Path of the SPARQL query in the repository that answers the competency question."@en ;
    rdfs:domain lexreq:CompetencyQuestion ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex/requirements> .

lexreq:sortKey a owl:DatatypeProperty ;
    rdfs:label "sort key"@en ;
    rdfs:comment "Key that orders the requirements by framework and number."@en ;
    rdfs:domain lexreq:Requirement ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lex/requirements> .

lexreq:Frameworks a skos:ConceptScheme ; skos:prefLabel "Frameworks"@en .
lexreq:AIAct a skos:Concept ; skos:inScheme lexreq:Frameworks ; skos:prefLabel "EU AI Act"@en ; skos:notation "AI Act" ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/oj> .
lexreq:ALTAI a skos:Concept ; skos:inScheme lexreq:Frameworks ; skos:prefLabel "Assessment List for Trustworthy AI"@en ; skos:notation "ALTAI" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> .
lexreq:OECD a skos:Concept ; skos:inScheme lexreq:Frameworks ; skos:prefLabel "OECD AI Principles"@en ; skos:notation "OECD" ;
    rdfs:seeAlso <https://oecd.ai/en/ai-principles> .
lexreq:GenderD32 a skos:Concept ; skos:inScheme lexreq:Frameworks ; skos:prefLabel "CERTAIN D3.2 gender requirements"@en ; skos:notation "Gender (D3.2)" ;
    rdfs:seeAlso <https://certain-project.eu/wp-content/uploads/2026/02/CERTAIN_WP3_D3.2_Ethical-considerations-of-AI-compliance_V1.0-delivered.pdf> .

################################################################################
# Requirements
################################################################################
lexreq:aiact-art9-1 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-009-0001" ;
    rdfs:label "Article 9(1)"@en ;
    lexreq:section "Article 9: Risk management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 9(1)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-9> ;
    dcterms:description "A risk management system shall be established, implemented, documented and maintained in relation to high-risk AI systems."@en ;
    lexreq:usesTerm aidoc:AISystem , aidoc:hasAIActivity , aidoc:hasLifecycleStage , aidoc:hasRisk , dpv-aiact:RiskManagementSystem , aidoc-lex:Procedure ;
    lexreq:expectedEvidence "Risk management policy"@en ;
    lexreq:expectedEvidence "Risk management procedure"@en ;
    lexreq:expectedEvidence "Risk register"@en ;
    lexreq:expectedEvidence "Risk management plan"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art9-1-cq1 , lexreq:aiact-art9-1-cq2 , lexreq:aiact-art9-1-cq3 , lexreq:aiact-art9-1-cq4 .
lexreq:aiact-art9-1-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What risk management system has been established for the high-risk AI system?"@en ; lexreq:formalisedBy "cq/art09_1_risk_management_system.rq" .
lexreq:aiact-art9-1-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How has it been implemented?"@en .
lexreq:aiact-art9-1-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What documentation records it?"@en .
lexreq:aiact-art9-1-cq4 a lexreq:CompetencyQuestion ; rdfs:label "How is it maintained over time?"@en .

lexreq:aiact-art9-2 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-009-0002" ;
    rdfs:label "Article 9(2)"@en ;
    lexreq:section "Article 9: Risk management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 9(2)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-9> ;
    dcterms:description "The risk management system shall be understood as a continuous iterative process planned and run throughout the entire lifecycle of a high-risk AI system, requiring regular systematic review and updating."@en ;
    lexreq:usesTerm aidoc:AISystem , aidoc:ChangeRecord , aidoc:endDate , aidoc:hasAIActivity , aidoc:hasFrequency , aidoc:hasLifecycleStage , aidoc:startDate , dpv-aiact:RiskManagementSystem ;
    lexreq:expectedEvidence "Lifecycle risk management procedure"@en ;
    lexreq:expectedEvidence "Review calendar"@en ;
    lexreq:expectedEvidence "Review minutes"@en ;
    lexreq:expectedEvidence "Update log"@en ;
    lexreq:expectedEvidence "Change history"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art9-2-cq1 , lexreq:aiact-art9-2-cq2 , lexreq:aiact-art9-2-cq3 , lexreq:aiact-art9-2-cq4 .
lexreq:aiact-art9-2-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What makes the process continuous and iterative?"@en .
lexreq:aiact-art9-2-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How is it run across the lifecycle?"@en .
lexreq:aiact-art9-2-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What review cycle exists?"@en .
lexreq:aiact-art9-2-cq4 a lexreq:CompetencyQuestion ; rdfs:label "How are updates recorded and implemented?"@en ; lexreq:formalisedBy "cq/art09_2_rms_updates.rq" .

lexreq:aiact-art9-2-a a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-009-0002-a" ;
    rdfs:label "Article 9(2)(a)"@en ;
    lexreq:section "Article 9: Risk management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 9(2)(a)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-9> ;
    dcterms:description "The identification and analysis of the known and the reasonably foreseeable risks that the high-risk AI system can pose to health, safety or fundamental rights when the high-risk AI system is used in accordance with its intended purpose."@en ;
    lexreq:usesTerm aidoc:AISystem , aidoc:hasIntendedPurpose , aidoc:hasRisk , aidoc-lex:HealthRisk , aidoc-lex:SafetyRisk , aidoc-lex:FundamentalRightsRisk , aidoc-lex:RiskAssessment ;
    lexreq:expectedEvidence "Hazard analysis"@en ;
    lexreq:expectedEvidence "FRIA / fundamental-rights risk analysis"@en ;
    lexreq:expectedEvidence "Intended purpose statement"@en ;
    lexreq:expectedEvidence "Risk register"@en ;
    lexreq:expectedEvidence "Expert review notes"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art9-2-a-cq1 , lexreq:aiact-art9-2-a-cq2 , lexreq:aiact-art9-2-a-cq3 , lexreq:aiact-art9-2-a-cq4 .
lexreq:aiact-art9-2-a-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What known risks are being identified?"@en ; lexreq:formalisedBy "cq/art09_2a_identified_risks.rq" .
lexreq:aiact-art9-2-a-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What reasonably foreseeable risks are being identified?"@en .
lexreq:aiact-art9-2-a-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How are they analysed?"@en .
lexreq:aiact-art9-2-a-cq4 a lexreq:CompetencyQuestion ; rdfs:label "What intended purpose is used as the baseline?"@en .

lexreq:aiact-art9-2-b a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-009-0002-b" ;
    rdfs:label "Article 9(2)(b)"@en ;
    lexreq:section "Article 9: Risk management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 9(2)(b)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-9> ;
    dcterms:description "The estimation and evaluation of the risks that may emerge when the high-risk AI system is used in accordance with its intended purpose, and under conditions of reasonably foreseeable misuse."@en ;
    lexreq:usesTerm aidoc:AISystem , aidoc:hasIntendedPurpose , aidoc:hasRisk , dpv-aiact:ReasonablyForeseeableMisuse , airo:Likelihood , airo:Severity , aidoc-lex:RiskAssessment ;
    lexreq:expectedEvidence "Risk scoring matrix"@en ;
    lexreq:expectedEvidence "Misuse scenario analysis"@en ;
    lexreq:expectedEvidence "Likelihood/severity assessment"@en ;
    lexreq:expectedEvidence "Risk evaluation report"@en ;
    lexreq:expectedEvidence "Assumptions log"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art9-2-b-cq1 , lexreq:aiact-art9-2-b-cq2 , lexreq:aiact-art9-2-b-cq3 , lexreq:aiact-art9-2-b-cq4 .
lexreq:aiact-art9-2-b-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How are the risks estimated when the high-risk AI system is used in accordance with its intended purpose?"@en ; lexreq:formalisedBy "cq/art09_2b_risk_estimation.rq" .
lexreq:aiact-art9-2-b-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How are the risks evaluated when the high-risk AI system is used in accordance with its intended purpose?"@en .
lexreq:aiact-art9-2-b-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What assumptions define foreseeable misuse?"@en .
lexreq:aiact-art9-2-b-cq4 a lexreq:CompetencyQuestion ; rdfs:label "What risks are estimated under reasonably foreseeable misuse?"@en .

lexreq:aiact-art9-2-c a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-009-0002-c" ;
    rdfs:label "Article 9(2)(c)"@en ;
    lexreq:section "Article 9: Risk management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 9(2)(c)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-9> ;
    dcterms:description "The evaluation of other risks possibly arising, based on the analysis of data gathered from the post-market monitoring system referred to in Article 72;"@en ;
    lexreq:usesTerm aidoc:DataMonitoringAndLogging , aidoc:Log , aidoc:PostMarketMonitoringActivity , aidoc:hasAIActivity , aidoc:hasRisk , aidoc:logsActivity , aidoc:storesLogsAt ;
    lexreq:expectedEvidence "Post-market monitoring plan"@en ;
    lexreq:expectedEvidence "Production logs"@en ;
    lexreq:expectedEvidence "Incident/complaint trend analysis"@en ;
    lexreq:expectedEvidence "Field performance reviews"@en ;
    lexreq:expectedEvidence "Updated risk register"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art9-2-c-cq1 , lexreq:aiact-art9-2-c-cq2 , lexreq:aiact-art9-2-c-cq3 .
lexreq:aiact-art9-2-c-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What additional risks are being identified from the post-market monitoring?"@en ; lexreq:formalisedBy "cq/art09_2c_post_market_risks.rq" .
lexreq:aiact-art9-2-c-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How are the monitoring data analysed?"@en .
lexreq:aiact-art9-2-c-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What evidence shows ongoing evaluation of new risks?"@en .

lexreq:aiact-art9-2-d a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-009-0002-d" ;
    rdfs:label "Article 9(2)(d)"@en ;
    lexreq:section "Article 9: Risk management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 9(2)(d)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-9> ;
    dcterms:description "The adoption of appropriate and targeted risk management measures designed to address the risks identified pursuant to point (a)."@en ;
    lexreq:usesTerm aidoc:AIActivity , aidoc:affects , aidoc:hasRisk , aidoc-lex:RiskControlMeasure ;
    lexreq:expectedEvidence "Risk management plan"@en ;
    lexreq:expectedEvidence "Control matrix"@en ;
    lexreq:expectedEvidence "Mitigation implementation records"@en ;
    lexreq:expectedEvidence "Design change requests"@en ;
    lexreq:expectedEvidence "Verification evidence"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art9-2-d-cq1 , lexreq:aiact-art9-2-d-cq2 .
lexreq:aiact-art9-2-d-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What measures are adopted?"@en ; lexreq:formalisedBy "cq/art09_2d_risk_control_measures.rq" .
lexreq:aiact-art9-2-d-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How are these measures designed to address the risks?"@en .

lexreq:aiact-art9-3 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-009-0003" ;
    rdfs:label "Article 9(3)"@en ;
    lexreq:section "Article 9: Risk management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 9(3)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-9> ;
    dcterms:description "The risks referred to in this Article shall concern only those which may be reasonably mitigated or eliminated through the development or design of the high-risk AI system, or the provision of adequate technical information."@en ;
    lexreq:usesTerm aidoc:AIDeployer , aidoc:AISystem , aidoc:hasRisk , aidoc:hasTransparencyMeasure , aidoc:isDeployedBy , dpv-aiact:InstructionForUse ;
    lexreq:expectedEvidence "Design risk reduction rationale"@en ;
    lexreq:expectedEvidence "Architecture/design controls"@en ;
    lexreq:expectedEvidence "Instructions for use"@en ;
    lexreq:expectedEvidence "Warnings/limitations"@en ;
    lexreq:expectedEvidence "Technical documentation"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art9-3-cq1 , lexreq:aiact-art9-3-cq2 .
lexreq:aiact-art9-3-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What risks can reasonably be mitigated or eliminated through the design or development of the high-risk system?"@en ; lexreq:formalisedBy "cq/art09_3_risks_reduced_by_design.rq" .
lexreq:aiact-art9-3-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What design or development architecture is required for the high-risk AI system to be almost risk free?"@en .

lexreq:aiact-art9-4 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-009-0004" ;
    rdfs:label "Article 9(4)"@en ;
    lexreq:section "Article 9: Risk management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 9(4)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-9> ;
    dcterms:description "The risk management measures referred to in paragraph 2, point (d), shall give due consideration to the effects and possible interaction resulting from the combined application of the requirements set out in this Section, with a view to minimising risks more effectively while achieving an appropriate balance in implementing the measures to fulfil those requirements."@en ;
    lexreq:usesTerm aidoc:AIDeployer , aidoc:AISystem , aidoc:hasRisk , aidoc:hasTransparencyMeasure , aidoc:isDeployedBy , dpv-aiact:InstructionForUse ;
    lexreq:expectedEvidence "Design risk reduction rationale"@en ;
    lexreq:expectedEvidence "Architecture/design controls"@en ;
    lexreq:expectedEvidence "Instructions for use"@en ;
    lexreq:expectedEvidence "Warnings/limitations"@en ;
    lexreq:expectedEvidence "Technical documentation"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art9-4-cq1 , lexreq:aiact-art9-4-cq2 , lexreq:aiact-art9-4-cq3 , lexreq:aiact-art9-4-cq4 .
lexreq:aiact-art9-4-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What possible interactions result from the combined application of the requirements set out in this Section?"@en .
lexreq:aiact-art9-4-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How do the risk management measures take those effects and interactions into account?"@en .
lexreq:aiact-art9-4-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How do the risk management measures minimise risks more effectively?"@en .
lexreq:aiact-art9-4-cq4 a lexreq:CompetencyQuestion ; rdfs:label "How is an appropriate balance achieved in implementing the measures?"@en ; lexreq:formalisedBy "cq/art09_4_balance_of_measures.rq" .

lexreq:aiact-art9-5 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-009-0005" ;
    rdfs:label "Article 9(5)"@en ;
    lexreq:section "Article 9: Risk management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 9(5)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-9> ;
    dcterms:description "The risk management measures referred to in paragraph 2, point (d), shall be such that the relevant residual risk associated with each hazard, as well as the overall residual risk of the high-risk AI systems is judged to be acceptable."@en ;
    lexreq:usesTerm aidoc:hasRisk , airo:Hazard , airo:Risk , aidoc-lex:riskAcceptanceCriteria ;
    lexreq:expectedEvidence "Residual risk assessment"@en ;
    lexreq:expectedEvidence "Hazard-by-hazard acceptance table"@en ;
    lexreq:expectedEvidence "Risk acceptance criteria"@en ;
    lexreq:expectedEvidence "Approval/sign-off"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art9-5-cq1 , lexreq:aiact-art9-5-cq2 , lexreq:aiact-art9-5-cq3 , lexreq:aiact-art9-5-cq4 .
lexreq:aiact-art9-5-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What is the residual risk associated with each hazard?"@en .
lexreq:aiact-art9-5-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What is the overall residual risk of the high-risk AI system?"@en .
lexreq:aiact-art9-5-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How is the acceptability of the residual risk associated with each hazard determined?"@en .
lexreq:aiact-art9-5-cq4 a lexreq:CompetencyQuestion ; rdfs:label "How is the acceptability of the overall residual risk of the high-risk AI system determined?"@en ; lexreq:formalisedBy "cq/art09_5_residual_risk_acceptance.rq" .

lexreq:aiact-art9-5-a a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-009-0005-a" ;
    rdfs:label "Article 9(5)(a)"@en ;
    lexreq:section "Article 9: Risk management system" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 9(5)(a)" ;
