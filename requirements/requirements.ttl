    aiact:hasCompetencyQuestion lexreq:aiact-art15-1-cq1 , lexreq:aiact-art15-1-cq2 .
lexreq:aiact-art15-1-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What is the level of accuracy, robustness, and cybersecurity achieved by the high-risk AI system?"@en ; lexreq:formalisedBy "cq/art15_1_achieved_levels.rq" .
lexreq:aiact-art15-1-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How does the high-risk AI system perform consistently in those respects throughout its lifecycle?"@en .

lexreq:aiact-art15-2 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-015-0002" ;
    rdfs:label "Article 15(2)"@en ;
    lexreq:section "Article 15: Accuracy, robustness and cybersecurity" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 15(2)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-15> ;
    dcterms:description "To address the technical aspects of how to measure the appropriate levels of accuracy and robustness set out in paragraph 1 and any other relevant performance metrics, the Commission shall, in cooperation with relevant stakeholders and organisations such as metrology and benchmarking authorities, encourage, as appropriate, the development of benchmarks and measurement methodologies."@en ;
    lexreq:usesTerm aidoc:ModelEvaluation , aidoc:PerformanceMetric , aidoc:Standard , aidoc:appliesStandard ;
