    lexreq:section "Article 72: Post-market monitoring by providers and post-market monitoring plan for high-risk AI systems" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter IX, Article 72(1)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-72> ;
    dcterms:description "Providers shall establish and document a post-market monitoring system in a manner that is proportionate to the nature of the AI technologies and the risks of the high-risk AI system."@en ;
    lexreq:usesTerm aidoc:AIProvider , aidoc:AISystem , aidoc:PostMarketMonitoringActivity , aidoc:hasAIActivity , aidoc:hasRisk , aidoc:isProvidedBy , dpv-aiact:PostMarketMonitoringSystem ;
    lexreq:expectedEvidence "Post-market monitoring procedure"@en ;
    lexreq:expectedEvidence "Post-market monitoring system description"@en ;
    lexreq:expectedEvidence "Proportionality rationale"@en ;
    lexreq:expectedEvidence "Risk-based monitoring design"@en ;
    lexreq:expectedEvidence "Provider governance record"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art72-1-cq1 .
lexreq:aiact-art72-1-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What post-market monitoring system is established and documented that is proportionate to the nature of the AI technologies and the risks of the high-risk AI system?"@en ; lexreq:formalisedBy "cq/art72_1_post_market_monitoring.rq" .

lexreq:aiact-art73-1 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-073-0001" ;
    rdfs:label "Article 73(1)"@en ;
    lexreq:section "Article 73: Reporting of serious incidents" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter IX, Article 73(1)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-73> ;
    dcterms:description "Providers of high-risk AI systems placed on the Union market must report any serious incident to the market surveillance authorities of the Member State where the incident occurred."@en ;
    lexreq:usesTerm aidoc:AIProvider , aidoc:AISystem , aidoc:hasRisk , aidoc:isProvidedBy , dpv-aiact:SeriousIncident , aidoc-lex:IncidentReport , aidoc-lex:CompetentAuthority ;
    lexreq:expectedEvidence "Serious incident report"@en ;
    lexreq:expectedEvidence "Authority submission record"@en ;
    lexreq:expectedEvidence "Incident register"@en ;
    lexreq:expectedEvidence "Provider notification procedure"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art73-1-cq1 .
lexreq:aiact-art73-1-cq1 a lexreq:CompetencyQuestion ; rdfs:label "Is there a process in place for the high-risk AI system to report any serious incidents to the market surveillance authorities of the Member State where the incident occurred?"@en ; lexreq:formalisedBy "cq/art73_1_incident_reporting_process.rq" .

lexreq:aiact-art73-2 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-073-0002" ;
    rdfs:label "Article 73(2)"@en ;
    lexreq:section "Article 73: Reporting of serious incidents" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter IX, Article 73(2)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-73> ;
    dcterms:description "The report under paragraph 1 must be made immediately after the provider has established a causal link, or a reasonable likelihood of one, between the AI system and the serious incident, and in any event no later than 15 days after the provider or, where applicable, the deployer becomes aware of the serious incident; the reporting period must take account of the severity of the serious incident."@en ;
    lexreq:usesTerm aidoc:AIDeployer , aidoc:AIProvider , aidoc:AISystem , aidoc:hasRisk , aidoc:isDeployedBy , aidoc:isProvidedBy , aidoc-lex:IncidentInvestigation , aidoc-lex:awarenessDate ;
    lexreq:expectedEvidence "Causality assessment"@en ;
    lexreq:expectedEvidence "Awareness timestamp"@en ;
    lexreq:expectedEvidence "Incident severity classification"@en ;
    lexreq:expectedEvidence "Dated authority report"@en ;
    lexreq:expectedEvidence "Reporting timeline log"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art73-2-cq1 , lexreq:aiact-art73-2-cq2 .
lexreq:aiact-art73-2-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How is the report made immediately available within the applicable reporting period?"@en ; lexreq:formalisedBy "cq/art73_2_incident_reporting.rq" .
lexreq:aiact-art73-2-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How does the reporting period take into account the severity of the serious incident?"@en .

lexreq:aiact-art73-3 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-073-0003" ;
    rdfs:label "Article 73(3)"@en ;
    lexreq:section "Article 73: Reporting of serious incidents" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter IX, Article 73(3)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-73> ;
    dcterms:description "For a widespread infringement or a serious incident under Article 3(49)(b), the report under paragraph 1 must be provided immediately and no later than two days after the provider or, where applicable, the deployer becomes aware of the incident."@en ;
    lexreq:usesTerm aidoc:AIDeployer , aidoc:AIProvider , aidoc:AISystem , aidoc:isDeployedBy , aidoc:isProvidedBy , aidoc-lex:WidespreadInfringement , dpv-aiact:SeriousIncident , aidoc-lex:awarenessDate ;
    lexreq:expectedEvidence "Widespread infringement assessment"@en ;
    lexreq:expectedEvidence "Serious incident classification"@en ;
    lexreq:expectedEvidence "Awareness record"@en ;
    lexreq:expectedEvidence "Expedited report submission"@en ;
    lexreq:expectedEvidence "Incident escalation file"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art73-3-cq1 , lexreq:aiact-art73-3-cq2 .
lexreq:aiact-art73-3-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What processes are in place for the provider for providing the report within two days?"@en ; lexreq:formalisedBy "cq/art73_3_provider_reporting_procedure.rq" .
lexreq:aiact-art73-3-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What processes are in place for the deployer for providing the report within two days?"@en .

lexreq:aiact-art73-4 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-073-0004" ;
    rdfs:label "Article 73(4)"@en ;
    lexreq:section "Article 73: Reporting of serious incidents" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter IX, Article 73(4)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-73> ;
    dcterms:description "In the event of the death of a person, the report must be provided immediately after the provider or deployer has established, or as soon as it suspects, a causal relationship between the high-risk AI system and the serious incident, and no later than 10 days after the provider or, where applicable, the deployer becomes aware of the serious incident."@en ;
    lexreq:usesTerm aidoc:AIDeployer , aidoc:AIProvider , aidoc:AISystem , aidoc:isDeployedBy , aidoc:isProvidedBy , dpv-aiact:SeriousIncident , aidoc-lex:IncidentInvestigation , aidoc-lex:awarenessDate ;
    lexreq:expectedEvidence "Fatal incident report"@en ;
    lexreq:expectedEvidence "Causality or suspicion record"@en ;
    lexreq:expectedEvidence "Awareness log"@en ;
    lexreq:expectedEvidence "Dated authority submission"@en ;
    lexreq:expectedEvidence "Escalation procedure"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art73-4-cq1 , lexreq:aiact-art73-4-cq2 , lexreq:aiact-art73-4-cq3 .
lexreq:aiact-art73-4-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What systems are in place for the provider or deployer to identify a suspected causal relationship between the high-risk AI system and a serious incident?"@en .
lexreq:aiact-art73-4-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What systems are in place for the provider or deployer to detect a serious incident?"@en .
lexreq:aiact-art73-4-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What systems are in place to ensure that the report is submitted within 10 days?"@en ; lexreq:formalisedBy "cq/art73_4_report_deadline.rq" .

lexreq:aiact-art73-5 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-073-0005" ;
    rdfs:label "Article 73(5)"@en ;
    lexreq:section "Article 73: Reporting of serious incidents" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter IX, Article 73(5)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-73> ;
    dcterms:description "Where necessary to ensure timely reporting, the provider or, where applicable, the deployer may submit an incomplete initial report followed by a complete report."@en ;
    lexreq:usesTerm aidoc:AIArtifact , aidoc:AIDeployer , aidoc:AIProvider , aidoc-lex:IncidentReport ;
    lexreq:expectedEvidence "Initial incident report"@en ;
    lexreq:expectedEvidence "Follow-up complete report"@en ;
    lexreq:expectedEvidence "Submission timestamps"@en ;
    lexreq:expectedEvidence "Reporting workflow"@en .

lexreq:aiact-art73-6 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-073-0006" ;
    rdfs:label "Article 73(6)"@en ;
    lexreq:section "Article 73: Reporting of serious incidents" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter IX, Article 73(6)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-73> ;
    dcterms:description "After reporting a serious incident under paragraph 1, the provider must without delay carry out the necessary investigations regarding the serious incident and the AI system concerned, including a risk assessment of the incident and corrective action; the provider must cooperate with the competent authorities and, where relevant, the notified body, and must not alter the AI system in a way that could affect later evaluation of the causes before informing the competent authorities."@en ;
    lexreq:usesTerm aidoc:AIProvider , aidoc:AISystem , aidoc:ChangeLog , aidoc:ChangeRecord , aidoc:hasChangeRecord , aidoc:hasRisk , aidoc:recordsChange , aidoc-lex:IncidentInvestigation , aidoc-lex:CorrectiveAction , aidoc-lex:AuthorityCommunication , aidoc-lex:RiskControlMeasure ;
    lexreq:expectedEvidence "Investigation report"@en ;
    lexreq:expectedEvidence "Incident risk assessment"@en ;
    lexreq:expectedEvidence "Corrective action plan"@en ;
    lexreq:expectedEvidence "Authority correspondence"@en ;
    lexreq:expectedEvidence "Notified body correspondence"@en ;
    lexreq:expectedEvidence "Change freeze record"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art73-6-cq1 , lexreq:aiact-art73-6-cq2 , lexreq:aiact-art73-6-cq3 , lexreq:aiact-art73-6-cq4 .
lexreq:aiact-art73-6-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What risk correction processes are in place for performing an investigation of a serious incident and the AI system?"@en ; lexreq:formalisedBy "cq/art73_6_investigation.rq" .
lexreq:aiact-art73-6-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How are the corrective actions taken?"@en .
lexreq:aiact-art73-6-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the provider cooperate with the competent authorities and, where relevant, the notified body?"@en ; lexreq:formalisedBy "cq/art73_6_authority_cooperation.rq" .
lexreq:aiact-art73-6-cq4 a lexreq:CompetencyQuestion ; rdfs:label "How is alteration of the AI system avoided before informing the competent authorities?"@en .

lexreq:aiact-art73-9 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-073-0009" ;
    rdfs:label "Article 73(9)"@en ;
    lexreq:section "Article 73: Reporting of serious incidents" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter IX, Article 73(9)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-73> ;
    dcterms:description "For Annex III high-risk AI systems placed on the market or put into service by providers subject to Union legislative instruments with equivalent reporting obligations, notification of serious incidents is limited to those under Article 3(49)(c)."@en ;
    lexreq:usesTerm aidoc:AIProvider , aidoc:AISystem , aidoc:Standard , aidoc:appliesStandard , aidoc:isProvidedBy , airo:Regulation , dpv-aiact:HighRiskAISystem-AnnexIII-1-a , aidoc-lex:FundamentalRightsInfringement ;
    lexreq:expectedEvidence "Annex III classification record"@en ;
    lexreq:expectedEvidence "Equivalent-reporting-obligation analysis"@en ;
    lexreq:expectedEvidence "Notification scope memo"@en ;
    lexreq:expectedEvidence "Incident notification record"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art73-9-cq1 .
lexreq:aiact-art73-9-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How are the reporting and notification of serious incidents obligations of high-risk AI systems falling under Annex III being satisfied from the provider as per Article 3(49)(c)?"@en .

lexreq:altai-r1-01 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r1-01" ;
    rdfs:label "Requirement 1: Human Agency and Oversight / Human Agency and Autonomy, item 1"@en ;
    lexreq:section "Requirement 1: Human Agency and Oversight" ;
    dcterms:source "ALTAI, Requirement 1: Human Agency and Oversight / Human Agency and Autonomy" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Is the AI system designed to interact, guide or take decisions by human end-users that affect humans or society?\nCould the AI system generate confusion for some or all end-users or subjects on whether a decision, content, advice or outcome is the result of an algorithmic decision?\nAre end-users or other subjects adequately made aware that a decision, content, advice or outcome is the result of an algorithmic decision?"@en ;
    lexreq:usesTerm aidoc:AISystem , aidoc:Interface , aidoc:TransparencyMeasure , aidoc:affects , aidoc:hasIntendedPurpose , aidoc:hasInterface , aidoc:hasTransparencyMeasure ;
    lexreq:expectedEvidence "System purpose statement and use-case specification"@en ;
    lexreq:expectedEvidence "User journey maps and interaction design documentation"@en ;
    lexreq:expectedEvidence "Screenshots or UI copy showing AI-generated output notices"@en ;
    lexreq:expectedEvidence "User-facing disclosure policy and onboarding text"@en ;
    lexreq:expectedEvidence "Requirements traceability matrix covering end-user notification"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r1-01-cq1 , lexreq:altai-r1-01-cq2 , lexreq:altai-r1-01-cq3 .
lexreq:altai-r1-01-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system interact with, guide, or take decisions that affect humans or society?"@en .
lexreq:altai-r1-01-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What mechanisms does the AI system provide to distinguish algorithmic outputs from human-generated decisions, content, advice, or outcomes?"@en .
lexreq:altai-r1-01-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system inform end-users and subjects whenever a decision, content item, advice, or outcome is generated by the AI system?"@en ; lexreq:formalisedBy "cq/altai_r1_ai_disclosure.rq" .

lexreq:altai-r1-02 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r1-02" ;
    rdfs:label "Requirement 1: Human Agency and Oversight / Human Agency and Autonomy, item 2"@en ;
    lexreq:section "Requirement 1: Human Agency and Oversight" ;
    dcterms:source "ALTAI, Requirement 1: Human Agency and Oversight / Human Agency and Autonomy" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Could the AI system generate confusion for some or all end-users or subjects on whether they are interacting with a human or AI system?\nAre end-users or subjects informed that they are interacting with an AI system?"@en ;
    lexreq:usesTerm aidoc:AISystem , aidoc:Interface , aidoc:TransparencyMeasure , aidoc:hasInterface , aidoc:hasStakeholder , aidoc:hasTransparencyMeasure ;
    lexreq:expectedEvidence "Conversational or interface disclosure requirements"@en ;
    lexreq:expectedEvidence "Usability test results on user understanding"@en ;
    lexreq:expectedEvidence "Product copy guidelines for AI interaction disclosure"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r1-02-cq1 , lexreq:altai-r1-02-cq2 , lexreq:altai-r1-02-cq3 .
lexreq:altai-r1-02-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system prevent confusion about whether a user is interacting with a human or with an AI system?"@en .
lexreq:altai-r1-02-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What disclosure mechanisms does the AI system provide to make users aware that they are interacting with an AI system?"@en .
lexreq:altai-r1-02-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system verify that these disclosures are clear and effective for representative users?"@en .

lexreq:altai-r1-03 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r1-03" ;
    rdfs:label "Requirement 1: Human Agency and Oversight / Human Agency and Autonomy, item 3"@en ;
    lexreq:section "Requirement 1: Human Agency and Oversight" ;
    dcterms:source "ALTAI, Requirement 1: Human Agency and Oversight / Human Agency and Autonomy" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Could the AI system affect human autonomy by generating over-reliance by end-users?\nDid you put in place procedures to avoid that end-users over-rely on the AI system?"@en ;
    lexreq:usesTerm aidoc:AISystem , aidoc:HumanOversightMechanism , aidoc:Interface , aidoc:affects , aidoc:hasHumanOversight , aidoc-lex:ImpactAssessment ;
    lexreq:expectedEvidence "Human factors risk assessment"@en ;
    lexreq:expectedEvidence "Oversight and escalation procedures"@en ;
    lexreq:expectedEvidence "UX patterns such as confirmations, confidence displays, or override steps"@en ;
    lexreq:expectedEvidence "Monitoring logs for user override and acceptance behaviour"@en ;
    lexreq:expectedEvidence "Autonomy harm mitigation plan"@en ;
    lexreq:expectedEvidence "Requirement 1: Human Agency and Oversight / Human Agency and Autonomy"@en ;
    lexreq:expectedEvidence "Could the AI system affect human autonomy by interfering with the end-user’s decision-making process in any other unintended and undesirable way?"@en ;
    lexreq:expectedEvidence "Did you put in place any procedure to avoid that the AI system inadvertently affects human autonomy?"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r1-03-cq1 , lexreq:altai-r1-03-cq2 , lexreq:altai-r1-03-cq3 .
lexreq:altai-r1-03-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system detect and reduce the risk of end-user over-reliance?"@en .
lexreq:altai-r1-03-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What controls or interface mechanisms does the AI system use to prevent users from deferring excessively to its outputs?"@en .
lexreq:altai-r1-03-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system avoid unintended interference with human autonomy or decision-making?"@en .

lexreq:altai-r1-04 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r1-04" ;
    rdfs:label "Requirement 1: Human Agency and Oversight / Human Agency and Autonomy, item 4"@en ;
    lexreq:section "Requirement 1: Human Agency and Oversight" ;
    dcterms:source "ALTAI, Requirement 1: Human Agency and Oversight / Human Agency and Autonomy" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Does the AI system simulate social interaction with or between end-users or subjects?"@en ;
    lexreq:usesTerm aidoc:AISystem , aidoc:Interface , aidoc:affects , aidoc:hasStakeholder , aidoc-lex:BehaviouralManipulationRisk , aidoc-lex:RiskControlMeasure ;
    lexreq:expectedEvidence "Psychosocial impact assessment"@en ;
    lexreq:expectedEvidence "Design review on persuasive or addictive patterns"@en ;
    lexreq:expectedEvidence "Safety guidelines for social or companion features"@en ;
    lexreq:expectedEvidence "Incident process for user wellbeing complaints"@en ;
    lexreq:expectedEvidence "Post-market monitoring metrics on high-risk engagement behaviour"@en ;
    lexreq:expectedEvidence "Requirement 1: Human Agency and Oversight / Human Agency and Autonomy"@en ;
    lexreq:expectedEvidence "Does the AI system risk creating human attachment, stimulating addictive behaviour, or manipulating user behaviour? Depending on which risks are possible or likely, please answer the questions below:"@en ;
    lexreq:expectedEvidence "Did you take measures to deal with possible negative consequences for end-users or subjects in case they develop a disproportionate attachment to the AI System?"@en ;
    lexreq:expectedEvidence "Did you take measures to minimise the risk of addiction?"@en ;
    lexreq:expectedEvidence "Did you take measures to mitigate the risk of manipulation?"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r1-04-cq1 , lexreq:altai-r1-04-cq2 , lexreq:altai-r1-04-cq3 .
lexreq:altai-r1-04-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system simulate social interaction with or between end-users or subjects?"@en .
lexreq:altai-r1-04-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What mechanisms does the AI system use to identify and limit risks of disproportionate attachment, addiction, or behavioural manipulation?"@en .
lexreq:altai-r1-04-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system monitor and mitigate attachment, addiction, and manipulation risks after deployment?"@en .

lexreq:altai-r1-05 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r1-05" ;
    rdfs:label "Requirement 1: Human Agency and Oversight / Human Oversight, item 5"@en ;
    lexreq:section "Requirement 1: Human Agency and Oversight" ;
    dcterms:source "ALTAI, Requirement 1: Human Agency and Oversight / Human Oversight" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Please determine whether the AI system (choose as many as appropriate):\nIs a self-learning or autonomous system;\nIs overseen by a Human-in-the-Loop;\nIs overseen by a Human-on-the-Loop;\nIs overseen by a Human-in-Command."@en ;
    lexreq:usesTerm aidoc:AISystem , aidoc:HumanOversightMechanism , aidoc:hasHumanOversight , aidoc:hasLifecycleStage , aidoc:usesAIMethod , airo:AutomationLevel ;
    lexreq:expectedEvidence "System classification record"@en ;
    lexreq:expectedEvidence "Oversight architecture diagram"@en ;
    lexreq:expectedEvidence "RACI matrix for decision authority and intervention points"@en ;
    lexreq:expectedEvidence "Governance memo explaining chosen oversight model"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r1-05-cq1 , lexreq:altai-r1-05-cq2 , lexreq:altai-r1-05-cq3 .
lexreq:altai-r1-05-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system determine whether it operates as a self-learning or autonomous system?"@en .
lexreq:altai-r1-05-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What oversight model does the AI system require, including human-in-the-loop, human-on-the-loop, or human-in-command?"@en .
lexreq:altai-r1-05-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system justify that the selected oversight model matches its risk profile and operating context?"@en .

lexreq:altai-r1-06 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r1-06" ;
    rdfs:label "Requirement 1: Human Agency and Oversight / Human Oversight, item 6"@en ;
    lexreq:section "Requirement 1: Human Agency and Oversight" ;
    dcterms:source "ALTAI, Requirement 1: Human Agency and Oversight / Human Oversight" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Have the humans (human-in-the-loop, human-on-the-loop, human-in-command) been given specific training on how to exercise oversight?"@en ;
    lexreq:usesTerm aidoc:AIAgent , aidoc:HumanOversightMechanism , aidoc:affects , aidoc:hasResponsibleDeveloper , aidoc:hasStakeholder , aidoc-lex:CompetenceTraining ;
    lexreq:expectedEvidence "Oversight training curriculum and attendance records"@en ;
    lexreq:expectedEvidence "SOPs for intervention and escalation"@en ;
    lexreq:expectedEvidence "Incident detection and response playbooks"@en ;
    lexreq:expectedEvidence "Adverse-event log and corrective action register"@en ;
    lexreq:expectedEvidence "Requirement 1: Human Agency and Oversight / Human Oversight"@en ;
    lexreq:expectedEvidence "Did you establish any detection and response mechanisms for undesirable adverse effects of the AI system for the end-user or subject?"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r1-06-cq1 , lexreq:altai-r1-06-cq2 , lexreq:altai-r1-06-cq3 .
lexreq:altai-r1-06-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system ensure that oversight personnel are trained to exercise oversight effectively?"@en .
lexreq:altai-r1-06-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What oversight roles, instructions, and decision rights does the AI system define for humans supervising it?"@en .
lexreq:altai-r1-06-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system detect, escalate, and support response to undesirable adverse effects on end-users or subjects?"@en .

lexreq:altai-r1-07 a lexreq:Requirement ;
