lexreq:aiact-art11-1 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-011-0001" ;
    rdfs:label "Article 11(1)"@en ;
    lexreq:section "Article 11: Technical documentation" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 11(1)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-11> ;
    dcterms:description "The technical documentation of a high-risk AI system shall be drawn up before that system is placed on the market or put into service and shall be kept up-to-date.\nThe technical documentation shall be drawn up in such a way as to demonstrate that the high-risk AI system complies with the requirements set out in this Section and to provide national competent authorities and notified bodies with the necessary information in a clear and comprehensive form to assess the compliance of the AI system with those requirements. It shall contain, at a minimum, the elements set out in Annex IV.\nSMEs, including start-ups, may provide the elements of the technical documentation specified in Annex IV in a simplified manner. To that end, the Commission shall establish a simplified technical documentation form targeted at the needs of small and microenterprises. Where an SME, including a start-up, opts to provide the information required in Annex IV in a simplified manner, it shall use the form referred to in this paragraph. Notified bodies shall accept the form for the purposes of the conformity assessment."@en ;
    lexreq:usesTerm aidoc:AIArtifact , aidoc:AIProvider , aidoc:AISystem , aidoc:ChangeLog , aidoc:ChangeRecord , aidoc:DataSheet , aidoc:DeclarationOfConformity , aidoc:HumanOversightMechanism , aidoc:PerformanceMetric , aidoc:TechnicalDocumentation , aidoc:TrainingDataSheet , aidoc:TransparencyMeasure , aidoc:hasChangeRecord , aidoc:hasHumanOversight , aidoc:hasPerformanceMetric , aidoc:hasTechnicalDocumentation , aidoc:hasTransparencyMeasure , aidoc:recordsChange , aidoc:version , aiact:Requirement , dpv:SMEOrganisation , dpv:StartupOrganisation , aidoc-lex:SimplifiedTechnicalDocumentation , aidoc-lex:Microenterprise , aidoc-lex:ConformityAssessment ;
    lexreq:expectedEvidence "Technical documentation file"@en ;
    lexreq:expectedEvidence "Version history"@en ;
    lexreq:expectedEvidence "Document control record"@en ;
    lexreq:expectedEvidence "Release-gate documentation"@en ;
    lexreq:expectedEvidence "Change log, Annex IV mapping table"@en ;
    lexreq:expectedEvidence "Compliance dossier"@en ;
    lexreq:expectedEvidence "System description"@en ;
    lexreq:expectedEvidence "Technical file"@en ;
    lexreq:expectedEvidence "Documentation package submitted for conformity assessment, Simplified technical documentation form"@en ;
    lexreq:expectedEvidence "SME eligibility record"@en ;
    lexreq:expectedEvidence "Submitted conformity assessment package"@en ;
    lexreq:expectedEvidence "Notified-body acceptance record"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art11-1-cq1 , lexreq:aiact-art11-1-cq2 , lexreq:aiact-art11-1-cq3 , lexreq:aiact-art11-1-cq4 , lexreq:aiact-art11-1-cq5 , lexreq:aiact-art11-1-cq6 , lexreq:aiact-art11-1-cq7 , lexreq:aiact-art11-1-cq8 , lexreq:aiact-art11-1-cq9 , lexreq:aiact-art11-1-cq10 .
lexreq:aiact-art11-1-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What is the technical documentation required of the high-risk AI system?"@en .
