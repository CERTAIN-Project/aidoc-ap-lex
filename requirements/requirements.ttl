lexreq:aiact-art10-3 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-010-0003" ;
    rdfs:label "Article 10(3)"@en ;
    lexreq:section "Article 10: Data and data governance" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 10(3)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-10> ;
    dcterms:description "Training, validation and testing data sets shall be relevant, sufficiently representative, and to the best extent possible, free of errors and complete in view of the intended purpose. They shall have the appropriate statistical properties, including, where applicable, as regards the persons or groups of persons in relation to whom the high-risk AI system is intended to be used. Those characteristics of the data sets may be met at the level of individual data sets or at the level of a combination thereof."@en ;
    lexreq:usesTerm aidoc:Dataset , aidoc:dataCharacteristic , aidoc:dataScope , aidoc:hasIntendedPurpose , aidoc:usesTestData , aidoc:usesTrainingData , aidoc:usesValidationData , aidoc:PerformanceMetric ;
    lexreq:expectedEvidence "Representativeness assessment"@en ;
    lexreq:expectedEvidence "Completeness report"@en ;
    lexreq:expectedEvidence "Error analysis"@en ;
    lexreq:expectedEvidence "Statistical profile"@en ;
    lexreq:expectedEvidence "Subgroup coverage analysis"@en ;
    lexreq:expectedEvidence "Dataset-combination rationale"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art10-3-cq1 , lexreq:aiact-art10-3-cq2 , lexreq:aiact-art10-3-cq3 , lexreq:aiact-art10-3-cq4 , lexreq:aiact-art10-3-cq5 .
lexreq:aiact-art10-3-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How are the training, validation and testing datasets sufficiently represented?"@en .
lexreq:aiact-art10-3-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How are the training, validation and testing datasets, to the best extent possible, free of errors and complete?"@en .
lexreq:aiact-art10-3-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What statistical properties do the datasets have?"@en ; lexreq:formalisedBy "cq/art10_3_statistical_properties.rq" .
lexreq:aiact-art10-3-cq4 a lexreq:CompetencyQuestion ; rdfs:label "How do those statistical properties relate to the persons or groups in relation to whom the system is intended to be used?"@en .
lexreq:aiact-art10-3-cq5 a lexreq:CompetencyQuestion ; rdfs:label "How are those characteristics meet at the level of individual datasets or at the level of a combination of datasets?"@en .

lexreq:aiact-art10-4 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-010-0004" ;
    rdfs:label "Article 10(4)"@en ;
    lexreq:section "Article 10: Data and data governance" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 10(4)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-10> ;
    dcterms:description "Data sets shall take into account, to the extent required by the intended purpose, the characteristics or elements that are particular to the specific geographical, contextual, behavioural or functional setting within which the high-risk AI system is intended to be used."@en ;
    lexreq:usesTerm aidoc:Dataset , aidoc:dataCharacteristic , aidoc:dataScope , aidoc:hasIntendedPurpose , aidoc:IntendedPurpose ;
    lexreq:expectedEvidence "Context-of-use specification"@en ;
    lexreq:expectedEvidence "Geographic coverage statement"@en ;
    lexreq:expectedEvidence "Behavioural/contextual analysis"@en ;
    lexreq:expectedEvidence "Functional setting description"@en ;
    lexreq:expectedEvidence "Dataset scope documentation"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art10-4-cq1 , lexreq:aiact-art10-4-cq2 , lexreq:aiact-art10-4-cq3 .
lexreq:aiact-art10-4-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What geographical characteristics or elements are taken into account in the datasets?"@en .
lexreq:aiact-art10-4-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What contextual, behavioural or functional characteristics or elements are taken into account in the datasets?"@en .
lexreq:aiact-art10-4-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How do the datasets reflect the functional setting in which the high-risk AI system is intended to be used?"@en ; lexreq:formalisedBy "cq/art10_4_functional_setting.rq" .

lexreq:aiact-art10-5 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-010-0005" ;
    rdfs:label "Article 10(5)"@en ;
    lexreq:section "Article 10: Data and data governance" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 10(5)" ;
    rdfs:seeAlso <https://ai-act-service-desk.ec.europa.eu/en/ai-act/article-10> ;
    dcterms:description "To the extent that it is strictly necessary for the purpose of ensuring bias detection and correction in relation to the high-risk AI systems in accordance with paragraph (2), points (f) and (g) of this Article, the providers of such systems may exceptionally process special categories of personal data, subject to appropriate safeguards for the fundamental rights and freedoms of natural persons. In addition to the provisions set out in Regulations (EU) 2016/679 and (EU) 2018/1725 and Directive (EU) 2016/680, all the following conditions must be met in order for such processing to occur:"@en ;
    lexreq:usesTerm aidoc:AIProvider , aidoc:AISystem , aidoc:hasRisk , aidoc-lex:containsSpecialCategoryData , aidoc-lex:BiasAssessment , aidoc-lex:CorrectiveAction , aidoc-lex:RiskControlMeasure , aidoc-lex:PrivacyPreservingMeasure ;
    lexreq:expectedEvidence "Necessity assessment"@en ;
    lexreq:expectedEvidence "Data-protection impact assessment"@en ;
    lexreq:expectedEvidence "Bias detection/correction protocol"@en ;
    lexreq:expectedEvidence "Safeguards register"@en ;
    lexreq:expectedEvidence "Access-control policy"@en ;
    lexreq:expectedEvidence "Processing record"@en ;
    aiact:hasCompetencyQuestion lexreq:aiact-art10-5-cq1 , lexreq:aiact-art10-5-cq2 , lexreq:aiact-art10-5-cq3 .
lexreq:aiact-art10-5-cq1 a lexreq:CompetencyQuestion ; rdfs:label "What special categories of personal data are processed for bias detection and correction?"@en ; lexreq:formalisedBy "cq/art10_5_special_category_data.rq" .
lexreq:aiact-art10-5-cq2 a lexreq:CompetencyQuestion ; rdfs:label "How is that processing of special categories of personal data strictly necessary for bias detection and correction?"@en .
lexreq:aiact-art10-5-cq3 a lexreq:CompetencyQuestion ; rdfs:label "What safeguard measures are applied for the processing of special categories of personal data ensuring the fundamental rights and freedoms of natural persons?"@en .

lexreq:aiact-art10-5-a a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:AIAct ;
    lexreq:sortKey "1-010-0005-a" ;
    rdfs:label "Article 10(5)(a)"@en ;
    lexreq:section "Article 10: Data and data governance" ;
    dcterms:source "Regulation (EU) 2024/1689, Chapter III, Article 10(5), point (a)" ;
