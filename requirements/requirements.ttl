    lexreq:usesTerm vair:SecurityMeasure , aidoc:Log , dpv-aiact:HumanOverseer , aidoc-lex:PrivacyPreservingMeasure , aidoc-lex:RiskControlMeasure ;
    lexreq:expectedEvidence "Access-control matrix"@en ;
