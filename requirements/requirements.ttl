    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "In cases of interactive AI systems (e.g., chatbots, robo-lawyers), do you communicate to users that they are interacting with an AI system instead of a human?"@en ;
    lexreq:usesTerm aidoc:Interface , aidoc:PerformanceMetric , aidoc:TransparencyMeasure , aidoc:hasInterface , aidoc:hasPerformanceMetric , aidoc:hasTransparencyMeasure ;
    lexreq:expectedEvidence "User documentation and onboarding material"@en ;
    lexreq:expectedEvidence "Disclosure and disclaimer text"@en ;
    lexreq:expectedEvidence "Accuracy or error-rate statements shown to users"@en ;
