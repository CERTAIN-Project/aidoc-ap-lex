    dcterms:source "ALTAI, Requirement 2: Technical Robustness and Safety / Resilience to Attack and Security" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/library/assessment-list-trustworthy-artificial-intelligence-altai-self-assessment> ;
    dcterms:description "Did you put measures in place to ensure the integrity, robustness and overall security of the AI system against potential attacks over its lifecycle?"@en ;
    lexreq:usesTerm aidoc:BuildAndIntegrationTesting , aidoc:ChangeLog , aidoc:ChangeRecord , aidoc:PostMarketMonitoringActivity , aidoc:SoftwareVersioning , aidoc:hasChangeRecord , aidoc:recordsChange ;
    lexreq:expectedEvidence "Security control catalogue"@en ;
    lexreq:expectedEvidence "Penetration test or red-team reports"@en ;
    lexreq:expectedEvidence "Remediation tracker"@en ;
    lexreq:expectedEvidence "Security update policy and end-user notice"@en ;
    lexreq:expectedEvidence "Release notes or vulnerability disclosure process"@en ;
    lexreq:expectedEvidence "Requirement 2: Technical Robustness and Safety / Resilience to Attack and Security"@en ;
    lexreq:expectedEvidence "Did you red-team/pentest the system?"@en ;
    lexreq:expectedEvidence "Did you inform end-users of the duration of security coverage and updates?"@en ;
    lexreq:expectedEvidence "What length is the expected timeframe within which you provide security updates for the AI system?"@en ;
    aiact:hasCompetencyQuestion lexreq:altai-r2-03-cq1 , lexreq:altai-r2-03-cq2 , lexreq:altai-r2-03-cq3 .
lexreq:altai-r2-03-cq1 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system protect its integrity, robustness, and security throughout its lifecycle?"@en .
lexreq:altai-r2-03-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What red-teaming or penetration-testing mechanisms does the AI system use, and how are findings resolved?"@en .
lexreq:altai-r2-03-cq3 a lexreq:CompetencyQuestion ; rdfs:label "How does the AI system communicate security coverage, update commitments, and support timeframes to end-users?"@en .

lexreq:altai-r2-04 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
