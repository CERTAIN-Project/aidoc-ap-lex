lexreq:altai-r5-03-cq2 a lexreq:CompetencyQuestion ; rdfs:label "What awareness or training mechanisms linked to the AI system reinforce bias-sensitive design and development practices?"@en .

lexreq:altai-r5-04 a lexreq:Requirement ;
    skos:inScheme lexreq: ;
    lexreq:framework lexreq:ALTAI ;
    lexreq:sortKey "2-altai-r5-04" ;
    rdfs:label "Requirement 5: Diversity, Non-discrimination and Fairness / Avoidance of Unfair Bias, item 4"@en ;
